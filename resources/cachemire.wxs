<?xml version="1.0" encoding="UTF-8"?>
<!-- Cachemire MSI (WiX v6 or v7, `cargo xtask build-windows`): per-machine, in-place upgrades (never change
     the UpgradeCode), a first page where nothing happens until Install, Update or Uninstall is clicked (a first
     install also asks there for the shortcuts), and an offer to open the app on the last (CachemireExitDlg). -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Cachemire"
           Manufacturer="Léo Parent"
           Version="$(var.Version)"
           UpgradeCode="7d3c1b62-0f4e-4c1a-9a1e-6e2f5b8c9d01"
           Language="1033"
           Scope="perMachine"
           Compressed="yes">

    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of Cachemire is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <!-- no System Restore point first: saving one holds the install up, before the administrator prompt -->
    <Property Id="MSIFASTINSTALL" Value="1" />

    <Icon Id="CachemireIcon" SourceFile="resources/icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="CachemireIcon" />
    <WixVariable Id="WixUIBannerBmp" Value="resources/installer/banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="resources/installer/dialog.bmp" />
    <Property Id="ARPCONTACT" Value="Léo Parent" />
    <Property Id="ARPCOMMENTS" Value="Knit-pick your Redis keys! (Cachemire $(var.FullVersion))" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/iRed4321/Cachemire" />
    <Property Id="ARPHELPLINK" Value="https://github.com/iRed4321/Cachemire/issues" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/iRed4321/Cachemire/releases" />
    <SetProperty Id="ARPINSTALLLOCATION" Value="[INSTALLFOLDER]" After="CostFinalize" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Cachemire" />
    </StandardDirectory>

    <Feature Id="Main" Title="Cachemire" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <!-- Uninstall with DELETEUSERDATA=1 (the checkbox of StartDlg): removes the user's data folder
         (connections, settings, history), as the user who runs the uninstall. -->
    <SetProperty Id="DeleteUserDataCmd" Value="[System64Folder]cmd.exe" Before="DeleteUserData" Sequence="execute" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE AND DELETEUSERDATA=1" />
    <CustomAction Id="DeleteUserData" Property="DeleteUserDataCmd" ExeCommand="/c rmdir /s /q &quot;[AppDataFolder]Cachemire&quot;" Execute="deferred" Impersonate="yes" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="DeleteUserData" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE AND DELETEUSERDATA=1" />
      <Custom Action="DeleteShortcuts" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="CreateDesktopShortcut" Before="InstallFinalize" Condition="ADDDESKTOP = 1 AND NOT Installed AND NOT WIX_UPGRADE_DETECTED" />
      <Custom Action="DeleteUserStartMenuShortcut" Before="InstallFinalize" Condition="WIX_UPGRADE_DETECTED AND NOT CACHEMIREREGISTERED AND NOT REMOVE" />
    </InstallExecuteSequence>

    <CustomAction Id="LaunchCachemire" FileRef="CachemireExe" ExeCommand="" Execute="immediate" Impersonate="yes" Return="asyncNoWait" />

    <!-- The shortcuts picked on the first page of a first install. The Start menu one is the package's
         own, for every user; an update keeps it or its absence (StartMenuShortcut, read below). The
         desktop one goes on the installing user's desktop only, made by a hidden PowerShell as that user. -->
    <Property Id="ADDSTARTMENU" Value="1" Secure="yes" />
    <Property Id="ADDDESKTOP" Value="1" Secure="yes" />
    <Property Id="DELETEUSERDATA" Secure="yes" />
    <Property Id="STARTMENUKEPT" Secure="yes">
      <RegistrySearch Id="StartMenuKeptSearch" Root="HKLM" Key="Software\Cachemire" Name="StartMenuShortcut" Type="raw" />
    </Property>
    <Property Id="CACHEMIREREGISTERED" Secure="yes">
      <RegistrySearch Id="RegisteredSearch" Root="HKLM" Key="Software\Cachemire" Name="Installed" Type="raw" />
    </Property>
    <SetProperty Id="ADDSTARTMENU" Value="0" After="AppSearch" Sequence="both" Condition="WIX_UPGRADE_DETECTED AND CACHEMIREREGISTERED AND NOT STARTMENUKEPT" />
    <SetProperty Id="CreateDesktopShortcut" Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command &quot;$w = New-Object -ComObject WScript.Shell; $l = $w.CreateShortcut($w.SpecialFolders('Desktop') + '\Cachemire.lnk'); $l.TargetPath = '[#CachemireExe]'; $l.Description = 'Knit-pick your Redis keys!'; $l.Save()&quot;" Before="CreateDesktopShortcut" Sequence="execute" Condition="ADDDESKTOP = 1 AND NOT Installed AND NOT WIX_UPGRADE_DETECTED" />
    <CustomAction Id="CreateDesktopShortcut" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec" Execute="deferred" Impersonate="yes" Return="ignore" />
    <!-- An update of a version that made the Start menu entry in the user's own folder: that one goes,
         the package's own replaces it. -->
    <SetProperty Id="DeleteUserStartMenuShortcut" Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command &quot;$w = New-Object -ComObject WScript.Shell; Remove-Item -LiteralPath ($w.SpecialFolders('Programs') + '\Cachemire.lnk') -ErrorAction SilentlyContinue&quot;" Before="DeleteUserStartMenuShortcut" Sequence="execute" Condition="WIX_UPGRADE_DETECTED AND NOT CACHEMIREREGISTERED AND NOT REMOVE" />
    <CustomAction Id="DeleteUserStartMenuShortcut" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec" Execute="deferred" Impersonate="yes" Return="ignore" />

    <!-- Uninstall (not the removal of an update): deletes the user's own shortcuts if they exist, as that user. -->
    <SetProperty Id="DeleteShortcuts" Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command &quot;$w = New-Object -ComObject WScript.Shell; Remove-Item -LiteralPath @(($w.SpecialFolders('Programs') + '\Cachemire.lnk'), ($w.SpecialFolders('Desktop') + '\Cachemire.lnk')) -ErrorAction SilentlyContinue&quot;" Before="DeleteShortcuts" Sequence="execute" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    <CustomAction Id="DeleteShortcuts" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec" Execute="deferred" Impersonate="yes" Return="ignore" />

    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Component Id="MainExe" Guid="c2a9e4d7-5b18-4f3e-8c6a-1d9e0f7b3a52">
        <File Id="CachemireExe" Source="$(var.ExePath)" Name="cachemire.exe" KeyPath="yes" />
      </Component>
      <!-- cachemire:// links (see crates/cachemire-core/src/link) open in the app, the link as its
           argument; an instance already running is handed the link (see crates/cachemire/src/links). -->
      <Component Id="LinkScheme" Guid="d37c22c6-2724-4fe2-93ce-9734bf6277d6">
        <RegistryKey Root="HKLM" Key="Software\Classes\cachemire">
          <RegistryValue Type="string" Value="URL:Cachemire link" KeyPath="yes" />
          <RegistryValue Type="string" Name="URL Protocol" Value="" />
          <RegistryKey Key="DefaultIcon">
            <RegistryValue Type="string" Value="&quot;[#CachemireExe]&quot;,0" />
          </RegistryKey>
          <RegistryKey Key="shell\open\command">
            <RegistryValue Type="string" Value="&quot;[#CachemireExe]&quot; &quot;%1&quot;" />
          </RegistryKey>
        </RegistryKey>
      </Component>
      <!-- Win+R and the address bar know `cachemire` (App Paths); Settings > Default apps lists it for
           cachemire:// links (RegisteredApplications, the Cachemire.Link ProgID); "Installed" tells an
           update that this version or a later one was there. -->
      <Component Id="Integration" Guid="5519469e-2d2e-4f95-960f-2a0a6fe08c50">
        <RegistryKey Root="HKLM" Key="Software\Cachemire" ForceDeleteOnUninstall="yes">
          <RegistryValue Type="string" Name="Installed" Value="1" KeyPath="yes" />
          <RegistryKey Key="Capabilities">
            <RegistryValue Type="string" Name="ApplicationName" Value="Cachemire" />
            <RegistryValue Type="string" Name="ApplicationDescription" Value="Knit-pick your Redis keys!" />
            <RegistryValue Type="string" Name="ApplicationIcon" Value="&quot;[#CachemireExe]&quot;,0" />
            <RegistryKey Key="URLAssociations">
              <RegistryValue Type="string" Name="cachemire" Value="Cachemire.Link" />
            </RegistryKey>
          </RegistryKey>
        </RegistryKey>
        <RegistryValue Root="HKLM" Key="Software\RegisteredApplications" Type="string" Name="Cachemire" Value="Software\Cachemire\Capabilities" />
        <RegistryKey Root="HKLM" Key="Software\Classes\Cachemire.Link">
          <RegistryValue Type="string" Value="Cachemire link" />
          <RegistryKey Key="DefaultIcon">
            <RegistryValue Type="string" Value="&quot;[#CachemireExe]&quot;,0" />
          </RegistryKey>
          <RegistryKey Key="shell\open\command">
            <RegistryValue Type="string" Value="&quot;[#CachemireExe]&quot; &quot;%1&quot;" />
          </RegistryKey>
        </RegistryKey>
        <RegistryKey Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\cachemire.exe">
          <RegistryValue Type="string" Value="[#CachemireExe]" />
          <RegistryValue Type="string" Name="Path" Value="[INSTALLFOLDER]" />
        </RegistryKey>
      </Component>
    </ComponentGroup>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="f70123ab-b8ff-4777-a2de-3875e917b263" Condition="ADDSTARTMENU = 1">
        <Shortcut Id="StartMenuShortcut" Name="Cachemire" Description="Knit-pick your Redis keys!" Target="[#CachemireExe]" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKLM" Key="Software\Cachemire" Type="string" Name="StartMenuShortcut" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <UI Id="CachemireUI">
      <UIRef Id="WixUI_Common" />
      <Property Id="WixUI_Mode" Value="Minimal" />
      <TextStyle Id="WixUI_Font_Normal" FaceName="Tahoma" Size="8" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Tahoma" Size="12" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Tahoma" Size="9" Bold="yes" />
      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />
      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="MsiRMFilesInUse" />
      <DialogRef Id="PrepareDlg" />
      <DialogRef Id="ProgressDlg" />
      <DialogRef Id="ResumeDlg" />
      <DialogRef Id="UserExit" />
      <DialogRef Id="CancelDlg" />

      <Dialog Id="StartDlg" Width="370" Height="270" Title="Cachemire $(var.FullVersion)">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />

        <Control Id="TitleInstall" Type="Text" X="15" Y="6" Width="340" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Install Cachemire $(var.FullVersion)" Hidden="yes" ShowCondition="NOT Installed AND NOT WIX_UPGRADE_DETECTED" />
        <Control Id="TitleUpdate" Type="Text" X="15" Y="6" Width="340" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Update Cachemire $(var.FullVersion)" Hidden="yes" ShowCondition="NOT Installed AND WIX_UPGRADE_DETECTED" />
        <Control Id="TitleUninstall" Type="Text" X="15" Y="6" Width="340" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Uninstall Cachemire $(var.FullVersion)" Hidden="yes" ShowCondition="Installed" />

        <Control Id="TextInstall" Type="Text" X="25" Y="70" Width="320" Height="60" Transparent="yes" NoPrefix="yes" Text="Click Install to add Cachemire to this computer. Nothing is installed until you do." Hidden="yes" ShowCondition="NOT Installed AND NOT WIX_UPGRADE_DETECTED" />
        <Control Id="TextUpdate" Type="Text" X="25" Y="70" Width="320" Height="60" Transparent="yes" NoPrefix="yes" Text="An older version of Cachemire is installed. Click Update to replace it with this version. Nothing changes until you do." Hidden="yes" ShowCondition="NOT Installed AND WIX_UPGRADE_DETECTED" />
        <Control Id="TextUninstall" Type="Text" X="25" Y="70" Width="320" Height="60" Transparent="yes" NoPrefix="yes" Text="Cachemire is installed on this computer. Click Uninstall to remove it. Nothing is removed until you do." Hidden="yes" ShowCondition="Installed" />

        <Control Id="StartMenuCheck" Type="CheckBox" X="25" Y="140" Width="320" Height="18" Property="ADDSTARTMENU" CheckBoxValue="1" Text="Add to the Start menu (for every user)" Hidden="yes" ShowCondition="NOT Installed AND NOT WIX_UPGRADE_DETECTED" />
        <Control Id="DesktopCheck" Type="CheckBox" X="25" Y="160" Width="320" Height="18" Property="ADDDESKTOP" CheckBoxValue="1" Text="Add a shortcut to my desktop" Hidden="yes" ShowCondition="NOT Installed AND NOT WIX_UPGRADE_DETECTED" />
        <Control Id="DeleteUserDataCheck" Type="CheckBox" X="25" Y="140" Width="320" Height="18" Property="DELETEUSERDATA" CheckBoxValue="1" Text="Also delete my connections, settings and history" Hidden="yes" ShowCondition="Installed" />

        <Control Id="InstallButton" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="Install" Hidden="yes" ShowCondition="NOT Installed AND NOT WIX_UPGRADE_DETECTED">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
        <Control Id="UpdateButton" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="Update" Hidden="yes" ShowCondition="NOT Installed AND WIX_UPGRADE_DETECTED">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
        <Control Id="UninstallButton" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="Uninstall" Hidden="yes" ShowCondition="Installed">
          <Publish Property="WixUI_InstallMode" Value="Remove" />
          <Publish Event="Remove" Value="All" Order="2" />
          <Publish Event="EndDialog" Value="Return" Order="3" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>

      <!-- WixUI's ExitDialog, with its offer to open Cachemire after an install or an update -->
      <Property Id="LAUNCHCACHEMIRE" Value="1" />
      <Dialog Id="CachemireExitDlg" Width="370" Height="270" Title="Cachemire $(var.FullVersion)">
        <Control Id="Finish" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Cancel="yes" Text="Finish">
          <Publish Event="DoAction" Value="LaunchCachemire" Order="1" Condition="LAUNCHCACHEMIRE = 1 AND NOT Installed AND NOT REMOVE" />
          <Publish Event="EndDialog" Value="Return" Order="2" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Disabled="yes" Text="Cancel" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Disabled="yes" Text="Back" />
        <Control Id="Bitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="234" TabSkip="no" Text="WixUI_Bmp_Dialog" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />

        <Control Id="TitleInstalled" Type="Text" X="135" Y="20" Width="220" Height="60" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Bigger}Cachemire $(var.FullVersion) is installed" Hidden="yes" ShowCondition="NOT Installed AND NOT WIX_UPGRADE_DETECTED" />
        <Control Id="TitleUpdated" Type="Text" X="135" Y="20" Width="220" Height="60" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Bigger}Cachemire is updated to $(var.FullVersion)" Hidden="yes" ShowCondition="NOT Installed AND WIX_UPGRADE_DETECTED" />
        <Control Id="TitleRemoved" Type="Text" X="135" Y="20" Width="220" Height="60" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Bigger}Cachemire is removed" Hidden="yes" ShowCondition="Installed AND REMOVE=&quot;ALL&quot;" />
        <Control Id="TitleDone" Type="Text" X="135" Y="20" Width="220" Height="60" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Bigger}Cachemire setup is complete" Hidden="yes" ShowCondition="Installed AND NOT REMOVE=&quot;ALL&quot;" />
        <Control Id="Description" Type="Text" X="135" Y="70" Width="220" Height="40" Transparent="yes" NoPrefix="yes" Text="Click Finish to close this window." />

        <Control Id="LaunchCheck" Type="CheckBox" X="135" Y="150" Width="220" Height="18" Property="LAUNCHCACHEMIRE" CheckBoxValue="1" Text="Open Cachemire now" Hidden="yes" ShowCondition="NOT Installed AND NOT REMOVE" />
      </Dialog>

      <InstallUISequence>
        <Show Dialog="StartDlg" Before="ProgressDlg" Condition="NOT REMOVE" />
        <Show Dialog="CachemireExitDlg" OnExit="success" />
      </InstallUISequence>
      <AdminUISequence>
        <Show Dialog="CachemireExitDlg" OnExit="success" />
      </AdminUISequence>
    </UI>
  </Package>
</Wix>
