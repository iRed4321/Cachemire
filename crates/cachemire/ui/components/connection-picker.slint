import { Theme } from "theme.slint";
import { HDivider, VScrollBar, IconButton, CheckRow, ModalButton, BackdropArea } from "widgets.slint";
import { IconPlus, IconPencil, IconCloud, IconDot, IconStar, IconCluster, IconLock } from "icons.slint";
import { PastePopup } from "widgets.slint";
import { SearchField } from "key-detail-widgets.slint";
import { ProfileTint, ConnProfileRowData, ConnectionRowData, ConnectionForm, AwsChip, PickerRow } from "types.slint";
import { ConnectionState, ConnectionEditor, Preferences } from "../globals.slint";
export { ConnProfileRowData, ConnectionRowData, ConnectionForm }

// the round swatch of a profile's tint
export component TintDot inherits Rectangle {
    in property <ProfileTint> tint;
    in property <length> size: Theme.px(12px);
    width: size;
    height: size;
    border-radius: size / 2;
    background: Theme.profile-color(tint);
}

// a connection open in this window: a green dot for the one in use, a green ring for one kept behind
component OpenMark inherits Rectangle {
    in property <bool> active;
    in property <bool> kept;
    width: Theme.px(14px);
    if root.active: IconDot {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        size: Theme.px(8px);
        tint: Theme.accent-green.darker(0.15);
    }
    if root.kept: Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: Theme.px(8px);
        height: self.width;
        border-radius: self.width / 2;
        border-width: Theme.px(1.5px);
        border-color: Theme.accent-green.darker(0.15);
    }
}

// A connection profile chip over a list: picked, it keeps the rows using that one.
export component ProfileChip inherits Rectangle {
    in property <AwsChip> data;
    in property <bool> on;
    callback clicked <=> area.clicked;

    height: Theme.px(22px);
    border-radius: self.height / 2;
    border-width: 1px;
    border-color: on ? Theme.accent-blue-dim : Theme.border-soft;
    background: on ? Theme.bg-selected-soft : (area.has-hover ? Theme.bg-hover-elevated : transparent);

    area := TouchArea { mouse-cursor: pointer; }
    HorizontalLayout {
        padding-left: Theme.px(9px);
        padding-right: Theme.px(9px);
        spacing: Theme.px(5px);
        if data.has-tint: VerticalLayout {
            alignment: center;
            TintDot { tint: data.tint; size: Theme.px(6px); }
        }
        Text {
            text: data.label;
            font-size: Theme.pt(11px);
            color: on || area.has-hover ? Theme.text-primary : Theme.text-secondary;
            vertical-alignment: center;
        }
        Text {
            text: data.count;
            font-size: Theme.pt(11px);
            color: Theme.text-tertiary;
            vertical-alignment: center;
        }
    }
}

// One segment of the source switch beside the filter: all, saved or cloud connections.
component SourceSegment inherits Rectangle {
    in property <AwsChip> data;
    in property <bool> on;
    callback clicked <=> area.clicked;

    width: row.preferred-width;
    background: on ? Theme.bg-selected-soft : (area.has-hover ? Theme.bg-hover-elevated : transparent);
    area := TouchArea { mouse-cursor: pointer; }
    row := HorizontalLayout {
        padding-left: Theme.px(9px);
        padding-right: Theme.px(9px);
        spacing: Theme.px(5px);
        Text {
            text: data.key == "saved" ? @tr("connection source" => "Saved") : data.label;
            font-size: Theme.pt(11px);
            color: on || area.has-hover ? Theme.text-primary : Theme.text-secondary;
            vertical-alignment: center;
        }
        Text {
            text: data.count;
            font-size: Theme.pt(11px);
            color: Theme.text-tertiary;
            vertical-alignment: center;
        }
    }
}

// A small dot between the facts of a row's second line.
component FactDot inherits VerticalLayout {
    alignment: center;
    IconDot { size: Theme.px(3px); tint: Theme.text-tertiary; }
}

// Floating list under the title bar's connection pill, like the AWS profiles' one: a filter, the
// source switch and profile chips, the pinned connections, then the saved and cloud ones (see
// connections::picker). Positioned and dismissed by main.slint.
export component ConnectionDropdown inherits Rectangle {
    in property <[PickerRow]> rows: ConnectionState.rows;
    in property <[PickerRow]> pins: ConnectionState.pins;
    // whether the clipboard holds text, for the filter's right-click "Paste"
    callback clipboard-has-text() -> bool;
    callback new-connection-clicked();
    // the import / export window
    callback transfer-clicked();
    callback connection-clicked(id: string);
    // the pencil of a row: its form, or a cloud connection's settings
    callback edit-clicked(id: string);
    callback closed();

    init => {
        ConnectionState.list-requested("");
    }

    width: Theme.px(520px);
    background: Theme.bg-elevated;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.border-soft;
    drop-shadow-color: Theme.shadow-color;
    drop-shadow-blur: Theme.shadow-blur;
    drop-shadow-offset-y: Theme.shadow-offset-y;
    property <length> row-height: Theme.px(34px);
    property <length> section-height: Theme.px(24px);
    property <length> list-max-height: Theme.px(420px);
    property <length> filter-height: Theme.px(40px);
    property <length> footer-height: Theme.px(36px);
    property <length> chip-height: Theme.px(22px);
    property <length> chip-gap: Theme.px(6px);
    property <int> chip-lines: ConnectionState.chip-lines.length;
    // the chips' lines and the line under them
    property <length> chips-height: chip-lines == 0 ? 0px : chip-lines * chip-height + (chip-lines - 1) * chip-gap + Theme.px(8px) + 1px;
    property <length> pin-height: Theme.px(28px);
    property <length> pin-gap: Theme.px(4px);
    property <int> pin-lines: ceil(pins.length / 2);
    property <length> pins-height: pins.length == 0 ? 0px : section-height + pin-lines * pin-height + (pin-lines - 1) * pin-gap + Theme.px(6px);
    property <length> content-height: rows.length == 0 ? (pins.length == 0 ? Theme.px(48px) : 0px)
        : rows.length * row-height + rows[rows.length - 1].sections-above * section-height + Theme.px(4px);
    property <length> list-height: min(list-max-height, content-height);
    // with no filter, source or chip, an empty list means nothing is saved yet
    property <bool> unfiltered: filter-box.text == "" && ConnectionState.source == "" && ConnectionState.chip == "";
    // sized to its parts (an unset height would stretch to the window's)
    height: filter-height + chips-height + pins-height + list-height + footer-height;

    // the top of row `i` in the list, its section's title above it
    pure function row-top(i: int) -> length {
        return i * row-height + rows[i].sections-above * section-height;
    }
    function move-highlight(to: int) {
        if rows.length == 0 {
            return;
        }
        ConnectionState.highlighted = max(0, min(rows.length - 1, to));
        let top = row-top(ConnectionState.highlighted) - (rows[ConnectionState.highlighted].section == "" ? 0px : section-height);
        let bottom = row-top(ConnectionState.highlighted) + row-height;
        if top < -list-flick.content-y {
            list-flick.content-y = -top;
        } else if bottom > -list-flick.content-y + list-flick.height {
            list-flick.content-y = -(bottom - list-flick.height);
        }
    }
    // lists again with what the filter holds, back at the top
    function relist() {
        ConnectionState.list-requested(filter-box.text);
        list-flick.content-y = 0;
    }

    // absorbs clicks on blank space so they don't close the dropdown
    TouchArea { }

    VerticalLayout {
        HorizontalLayout {
            height: filter-height;
            padding-left: Theme.px(8px);
            padding-right: Theme.px(10px);
            padding-top: Theme.px(8px);
            padding-bottom: Theme.px(6px);
            spacing: Theme.px(8px);
            filter-box := SearchField {
                auto-focus: true;
                placeholder: @tr("Search a name, host or profile...");
                font-size: Theme.pt(12px);
                height: Theme.px(26px);
                horizontal-stretch: 1;
                clipboard-has-text() => { return root.clipboard-has-text(); }
                // the list is filtered anew with its first row highlighted: back to the top
                edited => { root.relist(); }
                accepted => {
                    if rows.length > 0 {
                        root.connection-clicked(rows[ConnectionState.highlighted].id);
                    } else if pins.length > 0 {
                        root.connection-clicked(pins[0].id);
                    }
                }
                key-intercept(event) => {
                    if event.text == Key.UpArrow {
                        root.move-highlight(ConnectionState.highlighted - 1);
                        return true;
                    } else if event.text == Key.DownArrow {
                        root.move-highlight(ConnectionState.highlighted + 1);
                        return true;
                    } else if event.text == Key.Escape {
                        root.closed();
                        return true;
                    }
                    return false;
                }
            }
            if ConnectionState.sources.length > 0: Rectangle {
                y: (parent.height - self.height) / 2;
                height: Theme.px(22px);
                width: segments.preferred-width + 2px;
                border-radius: self.height / 2;
                border-width: 1px;
                border-color: Theme.border-soft;
                clip: true;
                segments := HorizontalLayout {
                    x: 1px;
                    y: 1px;
                    height: parent.height - 2px;
                    for s in ConnectionState.sources: SourceSegment {
                        data: s;
                        on: s.key == ConnectionState.source;
                        clicked => {
                            ConnectionState.source-picked(s.key);
                            root.relist();
                        }
                    }
                }
            }
            // as wide as the widest count it may show, so the filter keeps its width
            Rectangle {
                width: max(shown-count.preferred-width, unfiltered-count.preferred-width, filtered-count.preferred-width);
                unfiltered-count := Text {
                    visible: false;
                    text: ConnectionState.count-label-unfiltered;
                    font-size: Theme.pt(11px);
                }
                filtered-count := Text {
                    visible: false;
                    text: ConnectionState.count-label-filtered;
                    font-size: Theme.pt(11px);
                }
                shown-count := Text {
                    width: parent.width;
                    height: parent.height;
                    text: ConnectionState.count-label;
                    font-size: Theme.pt(11px);
                    color: Theme.text-tertiary;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
            }
        }

        if chip-lines > 0: VerticalLayout {
            height: chips-height;
            VerticalLayout {
                padding-left: Theme.px(8px);
                padding-right: Theme.px(10px);
                spacing: chip-gap;
                for line in ConnectionState.chip-lines: HorizontalLayout {
                    height: chip-height;
                    alignment: start;
                    spacing: chip-gap;
                    for c in line: ProfileChip {
                        data: c;
                        on: c.key == ConnectionState.chip;
                        // picked again, a chip lets go: all the connections are back
                        clicked => {
                            ConnectionState.chip-picked(c.key == ConnectionState.chip ? "" : c.key);
                            root.relist();
                        }
                    }
                }
            }
            Rectangle { }
            Rectangle {
                height: 1px;
                background: Theme.border-soft;
            }
        }

        // the pins: two per line, a click connects, the star unpins
        if pins.length > 0: Rectangle {
            height: pins-height;
            HorizontalLayout {
                y: 0;
                height: section-height;
                padding-left: Theme.px(12px);
                Text {
                    text: @tr("PINNED");
                    font-size: Theme.pt(10.5px);
                    font-weight: 600;
                    color: Theme.text-tertiary;
                    vertical-alignment: center;
                }
            }
            for p[i] in pins: Rectangle {
                property <length> tile-width: (parent.width - Theme.px(16px) - pin-gap) / 2;
                x: Theme.px(8px) + mod(i, 2) * (tile-width + pin-gap);
                y: section-height + floor(i / 2) * (pin-height + pin-gap);
                width: tile-width;
                height: pin-height;
                border-radius: Theme.radius-sm;
                border-width: 1px;
                border-color: p.active ? Theme.accent-blue-dim : Theme.border-soft;
                background: p.active ? Theme.bg-selected-soft
                    : (tile-area.has-hover ? Theme.bg-hover-elevated : Theme.bg-hover-elevated.mix(Theme.bg-elevated, 0.3));
                tile-area := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.connection-clicked(p.id); }
                }
                HorizontalLayout {
                    padding-left: Theme.px(8px);
                    padding-right: Theme.px(2px);
                    spacing: Theme.px(7px);
                    VerticalLayout {
                        alignment: center;
                        if p.has-tint: TintDot { tint: p.tint; size: Theme.px(7px); }
                        if !p.has-tint: IconDot { size: Theme.px(7px); tint: Theme.text-tertiary; }
                    }
                    Text {
                        text: p.name;
                        font-size: Theme.pt(12px);
                        font-weight: p.active ? 700 : 500;
                        color: Theme.text-primary;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                        min-width: 0px;
                    }
                    if p.active || p.kept: OpenMark { active: p.active; kept: p.kept; }
                    if p.cluster: VerticalLayout {
                        alignment: center;
                        IconCluster { size: Theme.px(12px); tint: Theme.text-tertiary; }
                    }
                    if p.ssh-label != "": VerticalLayout {
                        alignment: center;
                        IconLock { size: Theme.px(11px); tint: Theme.text-tertiary; }
                    }
                    VerticalLayout {
                        alignment: center;
                        IconButton {
                            box-size: Theme.px(22px);
                            hint: @tr("Unpin");
                            clicked => {
                                ConnectionState.pin-toggled(p.id);
                                root.relist();
                            }
                            IconStar { size: Theme.px(12px); filled: true; tint: Theme.accent-yellow; }
                        }
                    }
                }
            }
        }

        if rows.length == 0 && pins.length == 0: Text {
            height: list-height;
            text: root.unfiltered ? @tr("No saved connections yet") : @tr("No connection matches");
            color: Theme.text-tertiary;
            font-size: Theme.pt(12px);
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        HorizontalLayout {
            height: rows.length == 0 ? 0px : list-height;
            list-flick := Flickable {
                horizontal-stretch: 1;
                VerticalLayout {
                    width: list-flick.width;
                    alignment: start;
                    padding-bottom: Theme.px(4px);
                    for r[i] in rows: VerticalLayout {
                        if r.section != "": HorizontalLayout {
                            height: section-height;
                            padding-left: Theme.px(12px);
                            spacing: Theme.px(6px);
                            if r.cloud: VerticalLayout {
                                alignment: center;
                                IconCloud { size: Theme.px(12px); filled: true; tint: Theme.accent-orange; }
                            }
                            Text {
                                text: r.section;
                                font-size: Theme.pt(10.5px);
                                font-weight: 600;
                                color: Theme.text-tertiary;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                        }
                        Rectangle {
                            height: row-height;
                            Rectangle {
                                x: Theme.px(4px);
                                width: parent.width - Theme.px(8px);
                                border-radius: Theme.radius-sm;
                                background: r.active ? Theme.bg-selected-soft
                                    : (i == ConnectionState.highlighted || row-area.has-hover ? Theme.bg-hover-elevated : Theme.bg-elevated);
                                row-area := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.connection-clicked(r.id); }
                                }
                                HorizontalLayout {
                                    padding-left: Theme.px(8px);
                                    padding-right: Theme.px(6px);
                                    spacing: Theme.px(8px);
                                    // as the title bar's dot: in use, a green dot; kept open behind, a green ring
                                    OpenMark { active: r.active; kept: r.kept; }
                                    // one line: the name and address, what the connection has (profile,
                                    // cluster, tunnel, read-only), when it was last used
                                    HorizontalLayout {
                                        horizontal-stretch: 1;
                                        spacing: Theme.px(6px);
                                        Text {
                                            text: r.name;
                                            font-size: Theme.pt(12.5px);
                                            font-weight: r.active ? 700 : 500;
                                            color: Theme.text-primary;
                                            overflow: elide;
                                            max-width: Theme.px(200px);
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: r.address;
                                            font-size: Theme.pt(10.5px);
                                            font-family: Theme.font-mono;
                                            color: Theme.text-tertiary;
                                            overflow: elide;
                                            horizontal-stretch: 1;
                                            min-width: 0px;
                                            vertical-alignment: center;
                                        }
                                        if r.has-tint: VerticalLayout {
                                            alignment: center;
                                            TintDot { tint: r.tint; size: Theme.px(7px); }
                                        }
                                        if r.has-tint: Text {
                                            text: r.profile-label;
                                            font-size: Theme.pt(11px);
                                            color: Theme.text-secondary;
                                            overflow: elide;
                                            max-width: Theme.px(110px);
                                            vertical-alignment: center;
                                        }
                                        if r.has-tint && r.kind-label != "": FactDot { }
                                        if r.cluster: VerticalLayout {
                                            alignment: center;
                                            IconCluster { size: Theme.px(12px); tint: Theme.text-secondary; }
                                        }
                                        if r.kind-label != "": Text {
                                            text: r.kind-label;
                                            font-size: Theme.pt(11px);
                                            color: Theme.text-secondary;
                                            vertical-alignment: center;
                                        }
                                        if r.ssh-label != "" && (r.has-tint || r.kind-label != ""): FactDot { }
                                        if r.ssh-label != "": VerticalLayout {
                                            alignment: center;
                                            IconLock { size: Theme.px(11px); tint: Theme.text-secondary; }
                                        }
                                        if r.ssh-label != "": Text {
                                            text: r.ssh-label;
                                            font-size: Theme.pt(11px);
                                            color: Theme.text-secondary;
                                            vertical-alignment: center;
                                        }
                                        if r.read-only && (r.has-tint || r.kind-label != "" || r.ssh-label != ""): FactDot { }
                                        if r.read-only: Text {
                                            text: @tr("read-only");
                                            font-size: Theme.pt(11px);
                                            color: Theme.text-secondary;
                                            vertical-alignment: center;
                                        }
                                        Rectangle { width: Theme.px(4px); }
                                        Text {
                                            text: r.when;
                                            font-size: Theme.pt(11px);
                                            font-weight: r.active || r.kept ? 600 : 400;
                                            color: r.active || r.kept ? Theme.accent-green.darker(0.15) : Theme.text-tertiary;
                                            vertical-alignment: center;
                                        }
                                    }
                                    // the star and the pencil show on the row under the pointer or the keyboard
                                    VerticalLayout {
                                        alignment: center;
                                        IconButton {
                                            box-size: Theme.px(26px);
                                            hint: @tr("Pin to the top");
                                            opacity: row-area.has-hover || self.hovered || i == ConnectionState.highlighted ? 1 : 0;
                                            clicked => {
                                                ConnectionState.pin-toggled(r.id);
                                                root.relist();
                                            }
                                            IconStar { size: Theme.icon-sm; tint: Theme.text-secondary; }
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        IconButton {
                                            box-size: Theme.px(26px);
                                            hint: r.cloud ? @tr("Connection settings") : @tr("Edit connection");
                                            opacity: row-area.has-hover || self.hovered || i == ConnectionState.highlighted ? 1 : 0;
                                            clicked => { root.edit-clicked(r.id); }
                                            IconPencil { size: Theme.icon-sm; tint: Theme.text-secondary; }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            if list-flick.content-height > list-flick.height: VScrollBar {
                content-height: list-flick.content-height;
                content-y <=> list-flick.content-y;
            }
        }

        Rectangle {
            height: footer-height;
            Rectangle {
                y: 0;
                height: 1px;
                background: Theme.border-soft;
            }
            HorizontalLayout {
                padding-left: Theme.px(4px);
                padding-right: Theme.px(10px);
                spacing: Theme.px(2px);
                new-button := Rectangle {
                    y: (parent.height - self.height) / 2;
                    width: new-row.preferred-width + Theme.px(16px);
                    height: Theme.px(26px);
                    border-radius: Theme.radius-sm;
                    background: new-area.has-hover ? Theme.bg-hover-elevated : transparent;
                    new-area := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.new-connection-clicked(); }
                    }
                    new-row := HorizontalLayout {
                        x: Theme.px(8px);
                        spacing: Theme.px(6px);
                        VerticalLayout {
                            alignment: center;
                            IconPlus { size: Theme.px(13px); tint: Theme.accent-blue; }
                        }
                        Text {
                            text: @tr("New connection");
                            color: Theme.accent-blue;
                            font-size: Theme.pt(12px);
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                }
                Rectangle {
                    y: (parent.height - self.height) / 2;
                    width: transfer-label.preferred-width + Theme.px(16px);
                    height: Theme.px(26px);
                    border-radius: Theme.radius-sm;
                    background: transfer-area.has-hover ? Theme.bg-hover-elevated : transparent;
                    transfer-area := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.transfer-clicked(); }
                    }
                    transfer-label := Text {
                        text: @tr("Import / Export");
                        color: transfer-area.has-hover ? Theme.text-primary : Theme.text-secondary;
                        font-size: Theme.pt(12px);
                        vertical-alignment: center;
                    }
                }
                Text {
                    horizontal-stretch: 1;
                    text: @tr("↑↓ to move, Enter to connect");
                    font-size: Theme.pt(11px);
                    color: Theme.text-tertiary;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
    }
}

// Rectangle, not a VerticalLayout auto-sizing label+box: an unset height
// defaults to `vertical-stretch: 0`, and Slint stretches all-zero siblings
// anyway — the label would silently absorb leftover space. Pin heights instead.
export component ConnectionModalField inherits Rectangle {
    in property <string> label;
    in property <string> placeholder: "";
    in-out property <string> text: "";
    in property <bool> is-password: false;
    in property <bool> is-number: false;
    // whether the clipboard holds text, for the box's right-click "Paste"
    callback clipboard-has-text() -> bool;
    // Enter in the box
    callback accepted();
    // puts the cursor in the box, all of its text selected
    public function focus-all() {
        input.focus();
        input.select-all();
    }

    property <length> label-height: Theme.pt(15px);
    property <length> box-height: Theme.px(28px);
    property <length> row-spacing: Theme.px(4px);
    height: label-height + row-spacing + box-height;

    VerticalLayout {
        spacing: row-spacing;

        Text {
            text: label;
            height: label-height;
            font-size: Theme.pt(10.5px);
            font-weight: 600;
            color: Theme.text-secondary;
            vertical-alignment: center;
        }
        Rectangle {
            height: box-height;
            background: Theme.bg-sunken;
            border-radius: Theme.radius-sm;
            border-width: 1px;
            border-color: input.has-focus ? Theme.accent-blue-dim : Theme.border-soft;

            if root.text == "" && !input.has-focus: Text {
                text: root.placeholder;
                font-size: Theme.pt(11.5px);
                font-family: Theme.font-mono;
                color: Theme.text-tertiary;
                x: Theme.px(8px);
                width: parent.width - Theme.px(16px);
                height: 100%;
                vertical-alignment: center;
                overflow: elide;
            }
            // A bare TextInput never scrolls on its own — same fix as
            // Slint's LineEdit: it's as wide as its text, sliding inside a
            // clipping viewport so the cursor always stays in view.
            Rectangle {
                x: Theme.px(8px);
                width: parent.width - Theme.px(16px);
                height: 100%;
                clip: true;

                // right-click "Paste": see SearchField's own copy of this pattern
                // (key-detail-widgets.slint) for why the input sits inside the area
                input-area := TouchArea {
                    width: 100%;
                    height: 100%;
                    mouse-cursor: MouseCursor.text;
                    property <length> click-x;
                    property <length> click-y;
                    pointer-event(event) => {
                        if event.button == PointerEventButton.right && event.kind == PointerEventKind.down && root.clipboard-has-text() {
                            self.click-x = self.mouse-x;
                            self.click-y = self.mouse-y;
                            paste-popup.show();
                        }
                    }

                    input := TextInput {
                        property <length> computed-x;
                        x: min(0px, max(parent.width - self.width, self.computed-x));
                        width: max(parent.width, self.preferred-width);
                        height: 100%;
                        text <=> root.text;
                        font-size: Theme.pt(11.5px);
                        font-family: Theme.font-mono;
                        color: Theme.text-primary;
                        selection-background-color: Theme.accent-blue.with-alpha(0.35);
                        vertical-alignment: center;
                        input-type: is-password ? InputType.password : (is-number ? InputType.number : InputType.text);
                        accepted => { root.accepted(); }
                        cursor-position-changed(cursor-position) => {
                            if cursor-position.x + self.computed-x < 0px {
                                self.computed-x = -cursor-position.x;
                            } else if cursor-position.x + self.computed-x > parent.width - self.text-cursor-width {
                                self.computed-x = parent.width - cursor-position.x - self.text-cursor-width;
                            }
                        }
                    }
                    paste-popup := PastePopup {
                        x: input-area.click-x;
                        y: input-area.click-y;
                        paste => { input.paste(); }
                    }
                }
            }
        }
    }
}

// The connection profiles to pick one from: a radio row per profile in a box that scrolls past
// three and a half of them, or with `grows`, as tall as its rows unless its layout runs out of
// room (it then shrinks, down to three and a half rows, and scrolls).
export component ProfileChoiceList inherits Rectangle {
    in property <[ConnProfileRowData]> profiles: [];
    in-out property <string> selected: "";
    in property <bool> grows: false;

    property <length> row-height: Theme.px(28px);
    property <length> list-max-height: row-height * 3.5;
    property <length> full-height: profiles.length * row-height + Theme.px(2px);
    property <length> capped-height: min(profiles.length * row-height, list-max-height) + Theme.px(2px);

    min-height: capped-height;
    preferred-height: grows ? full-height : capped-height;
    max-height: grows ? full-height : capped-height;
    vertical-stretch: grows ? 1 : 0;
    background: Theme.bg-sunken;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.border-soft;

    HorizontalLayout {
        padding: Theme.px(1px);
        choice-flick := Flickable {
            horizontal-stretch: 1;
            interactive: true;
            choice-content := VerticalLayout {
                width: root.width - Theme.px(2px);
                alignment: start;
                for p in root.profiles: Rectangle {
                    width: choice-content.width;
                    height: root.row-height;
                    // opaque at rest (the list box's color): a hover change only redraws the row
                    background: choice-area.has-hover ? Theme.bg-hover-elevated : Theme.bg-sunken;
                    choice-area := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.selected = p.id; }
                    }
                    HorizontalLayout {
                        padding-left: Theme.px(10px);
                        padding-right: Theme.px(8px);
                        spacing: Theme.px(8px);
                        cross-axis-alignment: center;
                        Rectangle {
                            width: Theme.px(14px);
                            height: Theme.px(14px);
                            border-radius: self.width / 2;
                            border-width: 1.5px;
                            border-color: root.selected == p.id ? Theme.accent-blue : Theme.text-tertiary;
                            if root.selected == p.id: Rectangle {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                width: Theme.px(6px);
                                height: Theme.px(6px);
                                border-radius: self.width / 2;
                                background: Theme.accent-blue;
                            }
                        }
                        TintDot { tint: p.tint; }
                        Text {
                            text: p.name;
                            font-size: Theme.pt(12px);
                            color: Theme.text-primary;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                    }
                }
            }
        }
        // (it shows only while the rows don't fit)
        VScrollBar {
            content-height: choice-flick.content-height;
            content-y <=> choice-flick.content-y;
        }
    }
}

// The SSH tunnel's fields (host, port, login, key file), shared by the connection form and the
// cloud settings form; the caller shows it while the tunnel is on and handles `browse-key`.
export component SshTunnelFields inherits VerticalLayout {
    in-out property <string> host: "";
    in-out property <string> port: "";
    in-out property <string> username: "";
    in-out property <string> password: "";
    in-out property <string> key: "";
    in-out property <string> passphrase: "";
    // an existing tunnel: a blank password or passphrase keeps the stored one
    in property <bool> keep-secrets: false;
    // whether the clipboard holds text, for each field's right-click "Paste"
    callback clipboard-has-text() -> bool;
    // opens a file dialog for the private key; the caller fills `key`
    callback browse-key();

    spacing: Theme.px(10px);

    HorizontalLayout {
        spacing: Theme.px(10px);
        ConnectionModalField {
            clipboard-has-text() => { return root.clipboard-has-text(); }
            label: @tr("SSH host");
            placeholder: "bastion.example.com";
            text <=> root.host;
        }
        ConnectionModalField {
            clipboard-has-text() => { return root.clipboard-has-text(); }
            width: Theme.px(84px);
            label: @tr("SSH port");
            placeholder: "22";
            text <=> root.port;
            is-number: true;
        }
    }
    HorizontalLayout {
        spacing: Theme.px(10px);
        ConnectionModalField {
            clipboard-has-text() => { return root.clipboard-has-text(); }
            label: @tr("SSH username");
            placeholder: @tr("Active SSH profile");
            text <=> root.username;
        }
        ConnectionModalField {
            clipboard-has-text() => { return root.clipboard-has-text(); }
            label: @tr("SSH password");
            placeholder: root.keep-secrets ? @tr("Leave blank to keep current") : "";
            text <=> root.password;
            is-password: true;
        }
    }
    HorizontalLayout {
        spacing: Theme.px(8px);
        ConnectionModalField {
            clipboard-has-text() => { return root.clipboard-has-text(); }
            label: @tr("Private key file (optional)");
            placeholder: "~/.ssh/id_ed25519";
            text <=> root.key;
        }
        // level with the input box, under the label
        VerticalLayout {
            alignment: end;
            Rectangle {
                width: Theme.px(72px);
                height: Theme.px(28px);
                border-radius: Theme.radius-sm;
                border-width: 1px;
                border-color: Theme.border-soft;
                background: browse-area.has-hover ? Theme.bg-hover : transparent;
                browse-area := TouchArea { mouse-cursor: pointer; clicked => { root.browse-key(); } }
                Text {
                    text: @tr("Browse…");
                    color: Theme.text-secondary;
                    font-size: Theme.pt(12px);
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: 100%;
                    height: 100%;
                }
            }
        }
    }
    ConnectionModalField {
        clipboard-has-text() => { return root.clipboard-has-text(); }
        label: @tr("Key passphrase (if the key has one)");
        placeholder: root.keep-secrets ? @tr("Leave blank to keep current") : "";
        text <=> root.passphrase;
        is-password: true;
    }
    Text {
        text: @tr("Log in with a password, a private key, or both (the key is tried first). Leave the username empty to log in with the active SSH profile from Settings.");
        font-size: Theme.pt(10.5px);
        color: Theme.text-tertiary;
        wrap: word-wrap;
    }
}

// The kubeconfig's contexts to pick one from, in a box that scrolls past three and a half rows;
// clicking the chosen one again clears it.
export component ContextChoiceList inherits Rectangle {
    in property <[string]> items: [];
    in-out property <string> selected: "";

    property <length> row-height: Theme.px(26px);
    property <length> box-height: min(items.length * row-height, row-height * 3.5) + Theme.px(2px);

    height: box-height;
    background: Theme.bg-sunken;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.border-soft;

    HorizontalLayout {
        padding: Theme.px(1px);
        context-flick := Flickable {
            horizontal-stretch: 1;
            interactive: true;
            context-content := VerticalLayout {
                width: root.width - Theme.px(2px);
                alignment: start;
                for name in root.items: Rectangle {
                    width: context-content.width;
                    height: root.row-height;
                    background: context-area.has-hover ? Theme.bg-hover-elevated : Theme.bg-sunken;
                    context-area := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.selected = root.selected == name ? "" : name; }
                    }
                    Text {
                        x: Theme.px(10px);
                        width: parent.width - Theme.px(20px);
                        text: name;
                        font-size: Theme.pt(11.5px);
                        font-family: Theme.font-mono;
                        font-weight: root.selected == name ? 700 : 400;
                        color: root.selected == name ? Theme.accent-blue : Theme.text-primary;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }
        }
        VScrollBar {
            content-height: context-flick.content-height;
            content-y <=> context-flick.content-y;
        }
    }
}

// Full-window dimmed backdrop + centered card, for both "New connection…"
// (field-id empty) and modify (pre-filled by the caller). Password boxes
// start blank in edit mode — leaving one blank on save keeps it as stored.
export component ConnectionModal inherits Rectangle {
    in property <bool> is-edit: false;
    in property <string> error: ConnectionEditor.error;
    // whether the clipboard holds text, for each field's right-click "Paste"
    callback clipboard-has-text() -> bool;
    // the connection profiles to choose from (from Settings)
    in property <[ConnProfileRowData]> profiles: Preferences.conn-profiles;
    in-out property <string> field-id <=> ConnectionEditor.id;
    in-out property <string> field-name <=> ConnectionEditor.name;
    in-out property <string> field-connection-url <=> ConnectionEditor.connection-url;
    in-out property <string> field-username <=> ConnectionEditor.username;
    in-out property <string> field-password <=> ConnectionEditor.password;
    in-out property <bool> field-ssh-enabled <=> ConnectionEditor.ssh-enabled;
    in-out property <string> field-ssh-host <=> ConnectionEditor.ssh-host;
    in-out property <string> field-ssh-port <=> ConnectionEditor.ssh-port;
    in-out property <string> field-ssh-username <=> ConnectionEditor.ssh-username;
    in-out property <string> field-ssh-password <=> ConnectionEditor.ssh-password;
    in-out property <string> field-ssh-key <=> ConnectionEditor.ssh-key;
    in-out property <string> field-ssh-passphrase <=> ConnectionEditor.ssh-passphrase;
    in-out property <bool> field-kube-enabled <=> ConnectionEditor.kube-enabled;
    in-out property <string> field-kube-context <=> ConnectionEditor.kube-context;
    in-out property <string> field-kube-namespace <=> ConnectionEditor.kube-namespace;
    in-out property <string> field-kube-relay-pod <=> ConnectionEditor.kube-relay-pod;
    in-out property <bool> field-kube-temporary-relay <=> ConnectionEditor.kube-temporary-relay;
    in-out property <string> field-kube-relay-image <=> ConnectionEditor.kube-relay-image;
    // "Add a connection profile" is ticked, and the one chosen
    in-out property <bool> field-profile-enabled <=> ConnectionEditor.profile-enabled;
    in-out property <string> field-profile-id <=> ConnectionEditor.profile-id;
    // the connection's own read-only setting, and whether the profile chosen is read-only
    in-out property <bool> field-read-only <=> ConnectionEditor.read-only;
    property <bool> profile-read-only: field-profile-enabled && ConnectionEditor.profile-read-only(field-profile-id);
    callback save();
    save => { ConnectionEditor.saved(ConnectionEditor.form()); }
    callback cancel();
    cancel => { ConnectionEditor.open = false; }
    // checks that the form's connection can be reached; Rust fills the three below
    callback test();
    test => { ConnectionEditor.test-requested(ConnectionEditor.form()); }
    in property <bool> testing: ConnectionEditor.testing;
    in property <string> test-status: ConnectionEditor.test-status;
    in property <bool> test-ok: ConnectionEditor.test-ok;
    // asks for the connection being edited to be removed (edit mode only)
    callback delete();
    delete => { ConnectionEditor.deleted(ConnectionEditor.id); }
    // opens a file dialog for the private key; Rust fills `field-ssh-key`
    callback browse-key();
    browse-key => { ConnectionEditor.browse-key(); }
    property <bool> confirming-delete: false;

    background: #000000aa;

    BackdropArea {
        clicked => { root.cancel(); }
    }

    // Centers `card` via a real layout, not manual x/y: a free-floating
    // Rectangle never auto-sizes to content, so it'd silently fill its
    // parent instead. Layout-managed, it sizes to content like elsewhere.
    VerticalLayout {
        alignment: center;
        cross-axis-alignment: center;

        card := Rectangle {
            width: Theme.px(440px);
            background: Theme.bg-elevated;
            border-radius: Theme.radius-lg;
            border-width: 1px;
            border-color: Theme.border-soft;
            drop-shadow-color: Theme.shadow-color;
            drop-shadow-blur: Theme.shadow-blur;
            drop-shadow-offset-y: Theme.shadow-offset-y;

            // swallow clicks so they don't bubble to the backdrop's cancel
            TouchArea { }

            VerticalLayout {
                padding: Theme.px(16px);
                spacing: Theme.px(10px);

                Text {
                    text: is-edit ? @tr("Edit connection") : @tr("New connection");
                    height: Theme.pt(18px);
                    font-size: Theme.pt(14px);
                    font-weight: 700;
                    color: Theme.text-primary;
                    vertical-alignment: center;
                }

                ConnectionModalField {
                        clipboard-has-text() => { return root.clipboard-has-text(); } label: @tr("Name"); placeholder: "prod-cache-01"; text <=> root.field-name; }
                ConnectionModalField {
                        clipboard-has-text() => { return root.clipboard-has-text(); }
                    label: @tr("Connection URL");
                    placeholder: root.field-kube-enabled ? "redis://redis:6379" : "redis://user:pass@host:6379/0";
                    text <=> root.field-connection-url;
                }
                HorizontalLayout {
                    spacing: Theme.px(10px);
                    ConnectionModalField {
                        clipboard-has-text() => { return root.clipboard-has-text(); } label: @tr("Username (optional)"); text <=> root.field-username; }
                    ConnectionModalField {
                        clipboard-has-text() => { return root.clipboard-has-text(); }
                        label: @tr("Password");
                        placeholder: is-edit ? @tr("Leave blank to keep current") : "";
                        text <=> root.field-password;
                        is-password: true;
                    }
                }

                // the fields below only exist while the tunnel is on
                CheckRow {
                    text: @tr("Enable SSH Tunnel");
                    bold: true;
                    checked: root.field-ssh-enabled;
                    toggled => {
                        root.field-ssh-enabled = !root.field-ssh-enabled;
                        if root.field-ssh-enabled { root.field-kube-enabled = false; }
                    }
                }
                if root.field-ssh-enabled: SshTunnelFields {
                    clipboard-has-text() => { return root.clipboard-has-text(); }
                    keep-secrets: root.is-edit;
                    host <=> root.field-ssh-host;
                    port <=> root.field-ssh-port;
                    username <=> root.field-ssh-username;
                    password <=> root.field-ssh-password;
                    key <=> root.field-ssh-key;
                    passphrase <=> root.field-ssh-passphrase;
                    browse-key => { root.browse-key(); }
                }

                // the fields below only exist while the cluster is on
                CheckRow {
                    text: @tr("Inside a Kubernetes cluster");
                    bold: true;
                    checked: root.field-kube-enabled;
                    toggled => {
                        root.field-kube-enabled = !root.field-kube-enabled;
                        if root.field-kube-enabled {
                            root.field-ssh-enabled = false;
                            ConnectionEditor.kube-contexts-requested();
                        }
                    }
                }
                if root.field-kube-enabled: VerticalLayout {
                    spacing: Theme.px(10px);
                    ConnectionModalField {
                        clipboard-has-text() => { return root.clipboard-has-text(); }
                        label: @tr("Context");
                        placeholder: ConnectionEditor.kube-current-label;
                        text <=> root.field-kube-context;
                    }
                    if ConnectionEditor.kube-contexts.length > 0: ContextChoiceList {
                        items: ConnectionEditor.kube-contexts;
                        selected <=> root.field-kube-context;
                    }
                    ConnectionModalField {
                        clipboard-has-text() => { return root.clipboard-has-text(); }
                        label: @tr("Namespace");
                        placeholder: @tr("the context's namespace");
                        text <=> root.field-kube-namespace;
                    }
                    // a relay pod started for the connection, or one named
                    CheckRow {
                        text: @tr("Start a temporary relay pod");
                        checked: root.field-kube-temporary-relay;
                        toggled => { root.field-kube-temporary-relay = !root.field-kube-temporary-relay; }
                    }
                    if root.field-kube-temporary-relay: ConnectionModalField {
                        clipboard-has-text() => { return root.clipboard-has-text(); }
                        label: @tr("Relay image");
                        placeholder: ConnectionEditor.kube-default-relay-image;
                        text <=> root.field-kube-relay-image;
                    }
                    if !root.field-kube-temporary-relay: ConnectionModalField {
                        clipboard-has-text() => { return root.clipboard-has-text(); }
                        label: @tr("Relay pod");
                        placeholder: @tr("none");
                        text <=> root.field-kube-relay-pod;
                    }
                    Text {
                        text: root.field-kube-temporary-relay
                            ? @tr("Cachemire starts a small pod in the namespace while connected and deletes it once disconnected. Your account needs to create, delete and exec into pods there. Another image needs sh with socat, nc or bash.")
                            : @tr("For a Service with no pods behind it, or a server outside the cluster: a pod with socat, nc or bash connects for Cachemire.");
                        font-size: Theme.pt(10.5px);
                        color: Theme.text-tertiary;
                        wrap: word-wrap;
                    }
                }

                // the list only exists while the profile is on
                CheckRow {
                    text: @tr("Add a connection profile");
                    bold: true;
                    checked: root.field-profile-enabled;
                    toggled => {
                        root.field-profile-enabled = !root.field-profile-enabled;
                        // ticking it picks the first one, so it is never on with nothing chosen
                        if root.field-profile-enabled && root.field-profile-id == "" && root.profiles.length > 0 {
                            root.field-profile-id = root.profiles[0].id;
                        }
                    }
                }
                if root.field-profile-enabled && root.profiles.length > 0: ProfileChoiceList {
                    profiles: root.profiles;
                    selected <=> root.field-profile-id;
                }
                if root.field-profile-enabled && root.profiles.length == 0: Text {
                    text: @tr("No connection profiles yet: create one in Settings.");
                    font-size: Theme.pt(10.5px);
                    color: Theme.text-tertiary;
                    wrap: word-wrap;
                }

                // ticked and greyed out while the chosen profile is read-only; the connection's own
                // setting is kept underneath
                CheckRow {
                    text: @tr("Read-only");
                    bold: true;
                    enabled: !root.profile-read-only;
                    checked: root.field-read-only || root.profile-read-only;
                    toggled => { root.field-read-only = !root.field-read-only; }
                }
                Text {
                    text: root.profile-read-only ? @tr("Its profile is read-only.") : @tr("No key or value can be changed through this connection.");
                    font-size: Theme.pt(10.5px);
                    color: Theme.text-tertiary;
                    wrap: word-wrap;
                }

                if error != "": Text {
                    text: error;
                    height: Theme.pt(14px);
                    color: Theme.accent-red;
                    font-size: Theme.pt(11px);
                    vertical-alignment: center;
                    overflow: elide;
                }

                // room for two lines, so a test result doesn't change the form's height
                Text {
                    text: root.test-status;
                    height: Theme.pt(30px);
                    color: root.test-ok ? Theme.accent-green : Theme.accent-red;
                    font-size: Theme.pt(11px);
                    wrap: word-wrap;
                    overflow: elide;
                }

                HorizontalLayout {
                    height: Theme.px(28px);
                    spacing: Theme.px(8px);
                    // removing is one click to arm, a second to do it: the
                    // button stays armed until the form is closed
                    if root.is-edit: ModalButton {
                        text: root.confirming-delete ? @tr("Click again to delete") : @tr("Delete");
                        danger: true;
                        armed: root.confirming-delete;
                        clicked => {
                            if root.confirming-delete {
                                root.delete();
                            } else {
                                root.confirming-delete = true;
                            }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    ModalButton {
                        text: root.testing ? @tr("Testing…") : @tr("Test connection");
                        clicked => { if !root.testing { root.test(); } }
                    }
                    ModalButton { text: @tr("Cancel"); clicked => { root.cancel(); } }
                    ModalButton { text: @tr("Save"); primary: true; clicked => { root.save(); } }
                }
            }
        }
    }
}
