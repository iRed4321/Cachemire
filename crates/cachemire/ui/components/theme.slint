// Bundled fonts (resources/fonts, SIL Open Font License texts alongside).
// Importing registers each with the renderer at window creation; build.rs
// embeds the files. Roboto has no 600 weight, so 600 renders as its Bold.
import "../../../../resources/fonts/Roboto-Regular.ttf";
import "../../../../resources/fonts/Roboto-Italic.ttf";
import "../../../../resources/fonts/Roboto-Medium.ttf";
import "../../../../resources/fonts/Roboto-Bold.ttf";
import "../../../../resources/fonts/JetBrainsMono-Regular.ttf";
import "../../../../resources/fonts/JetBrainsMono-SemiBold.ttf";
import "../../../../resources/fonts/JetBrainsMono-Bold.ttf";

import { ProfileTint } from "types.slint";

// The colors are set from Rust (src/theme/mod.rs), which derives them from the four of the
// theme picked in the settings; the values here are those of the default theme.
export global Theme {
    // backgrounds: the app's own background (behind the panels and title bar) is
    // `bg-app-base` with some of the tint of the connection profile in use mixed in,
    // unless its tint is light: only the borders then (set from Rust)
    in property <color> bg-app-base: #151517;
    in-out property <bool> env-tinted: false;
    in-out property <ProfileTint> env-tint: ProfileTint.red;
    in-out property <bool> env-light: false;
    // how much of the tint is mixed into the background: enough to tell the
    // environments apart at a glance, not enough to tire the eye
    out property <float> env-tint-strength: 0.25;
    // (`mix` weighs the color it is called on by the factor)
    out property <color> bg-app: env-tinted && !env-light ? profile-color(env-tint).mix(bg-app-base, env-tint-strength) : bg-app-base;
    // the border of the app's own chrome (keyspace panel, key panel, title bar pills):
    // plain `border-soft` untinted, well into the profile's color when one is in use
    out property <float> env-border-strength: 0.5;
    out property <color> chrome-border: env-tinted ? profile-color(env-tint).mix(border-soft, env-border-strength) : border-soft;
    in property <color> bg-panel: #19191c;
    in property <color> bg-sunken: #111113;
    in property <color> bg-elevated: #222226;
    in property <color> bg-hover: #232327;
    // hover for rows sitting on bg-elevated (dropdowns, context menus): the
    // plain bg-hover is only a hair lighter than bg-elevated and reads as no
    // hover at all there
    in property <color> bg-hover-elevated: #34343b;
    in property <color> bg-selected: #2a4a76;
    in property <color> bg-selected-soft: #22344d;

    // borders
    in property <color> border: #2d2d30;
    in property <color> border-soft: #333336;

    // text
    in property <color> text-primary: #e7e7ea;
    in property <color> text-secondary: #b4b4b9;
    in property <color> text-tertiary: #909096;
    in property <color> text-disabled: #6e6e73;

    // accents
    in property <color> accent-blue: #5b9dff;
    in property <color> accent-blue-dim: #3d6fc4;
    // text and icons on the accent (a primary button's)
    in property <color> accent-text: #ffffff;
    in property <color> accent-red: #ff5f56;
    in property <color> accent-yellow: #ffbd2e;
    in property <color> accent-green: #29c46f;
    in property <color> accent-orange: #ff9f45;
    in property <color> accent-purple: #b389f9;
    in property <color> accent-cyan: #6fd1e0;

    // the full color of each profile tint (its swatch): the same whatever the theme
    pure public function profile-color(tint: ProfileTint) -> color {
        if (tint == ProfileTint.red) { return #ff5f56; }
        if (tint == ProfileTint.orange) { return #ff9f45; }
        if (tint == ProfileTint.yellow) { return #ffbd2e; }
        if (tint == ProfileTint.green) { return #29c46f; }
        if (tint == ProfileTint.cyan) { return #6fd1e0; }
        if (tint == ProfileTint.purple) { return #b389f9; }
        if (tint == ProfileTint.pink) { return #ff7eb9; }
        return #5b9dff;
    }
    // bumped when the theme changes: what Rust colors (a query's text) is asked for again
    in property <int> paint-tick: 0;

    // fonts: the ones bundled with the app (see the imports at the top of this file)
    // unless the Display settings picked installed ones (set from Rust)
    in property <string> font-ui: "Roboto";
    in property <string> font-mono: "JetBrains Mono";

    // UI zoom: 1.0 = 100%. Multiply any base pixel value through `Theme.px()`
    // (or `Theme.pt()` for font sizes) so it scales with Ctrl+/Ctrl-/Ctrl+scroll.
    in-out property <float> zoom: 1.0;
    out property <float> zoom-min: 0.6;
    out property <float> zoom-max: 2.0;

    pure public function px(base: length) -> length {
        return base * zoom;
    }
    pure public function pt(base: length) -> length {
        return base * zoom;
    }

    // metrics
    out property <length> radius-sm: px(4px);
    out property <length> radius-md: px(6px);
    out property <length> radius-lg: px(14px);
    out property <length> gap: px(10px);
    // thickness of a scrollbar's track: the strip that wakes the bar when the
    // pointer comes near it (the thumb inside is thinner)
    out property <length> scrollbar-size: px(14px);
    // the key panel's views (fields, table): scrollbars drawn thicker, shown once the
    // pointer is this close to their edge, and left a while longer after
    out property <float> view-scrollbar-scale: 1.5;
    out property <length> view-scrollbar-reach: px(48px);
    out property <duration> view-scrollbar-linger: 2s;

    // icon glyph sizes — the size passed to an Icon* component's `size` property
    out property <length> icon-xs: px(12px);  // chevrons, tiny accents
    out property <length> icon-sm: px(14px);  // compact/copy icons
    out property <length> icon-md: px(16px);  // standard toolbar icons
    out property <length> icon-lg: px(18px);  // close crosses, prominent/rail icons

    // icon button hit-area sizes — the `box-size` of an IconButton
    out property <length> btn-sm: px(22px);   // compact copy buttons
    out property <length> btn-md: px(26px);   // standard toolbar buttons
    out property <length> btn-lg: px(29px);   // prominent action buttons
    out property <length> btn-rail: px(40px); // icon rail buttons

    // shared floating-card shadow
    out property <color> shadow-color: #00000055;
    out property <length> shadow-blur: px(7px);
    out property <length> shadow-offset-y: px(2px);
}
