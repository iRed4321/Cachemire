import { Theme } from "theme.slint";
import { VScrollBar, IconButton } from "widgets.slint";
import { SearchField } from "key-detail-widgets.slint";
import { TintDot, ProfileChip } from "connection-picker.slint";
import { IconCheck, IconDot, IconRefresh, IconSettings, IconStar } from "icons.slint";
import { AwsAccount } from "../globals.slint";
import { AwsChip, AwsProfileRow } from "types.slint";

// Floating list under the title bar's AWS pill: a filter, chips keeping one connection profile,
// the pinned profiles two per line, then the recent ones and the others, each with its account's
// settings, a star to pin it and a gear. Positioned and dismissed by main.slint.
export component AwsProfileDropdown inherits Rectangle {
    in property <[AwsProfileRow]> profiles: AwsAccount.profiles;
    in property <[AwsProfileRow]> pins: AwsAccount.pins;
    in property <string> selected: AwsAccount.profile;
    // whether the clipboard holds text, for the filter's right-click "Paste"
    callback clipboard-has-text() -> bool;
    callback picked(name: string);
    callback settings-clicked(name: string);
    callback sign-out-clicked();
    callback closed();

    init => {
        AwsAccount.list-requested("");
    }

    width: Theme.px(460px);
    background: Theme.bg-elevated;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.border-soft;
    drop-shadow-color: Theme.shadow-color;
    drop-shadow-blur: Theme.shadow-blur;
    drop-shadow-offset-y: Theme.shadow-offset-y;
    property <length> row-height: Theme.px(34px);
    property <length> section-height: Theme.px(24px);
    property <length> list-max-height: Theme.px(400px);
    property <length> filter-height: Theme.px(40px);
    property <length> footer-height: Theme.px(36px);
    property <length> chip-height: Theme.px(22px);
    property <length> chip-gap: Theme.px(6px);
    property <int> chip-lines: AwsAccount.chip-lines.length;
    // the chips' lines and the line under them
    property <length> chips-height: chip-lines == 0 ? 0px : chip-lines * chip-height + (chip-lines - 1) * chip-gap + Theme.px(8px) + 1px;
    property <length> pin-height: Theme.px(28px);
    property <length> pin-gap: Theme.px(4px);
    property <int> pin-lines: ceil(pins.length / 2);
    property <length> pins-height: pins.length == 0 ? 0px : section-height + pin-lines * pin-height + (pin-lines - 1) * pin-gap + Theme.px(6px);
    property <length> content-height: profiles.length == 0 ? (pins.length == 0 ? Theme.px(48px) : 0px)
        : profiles.length * row-height + profiles[profiles.length - 1].sections-above * section-height + Theme.px(4px);
    property <length> list-height: min(list-max-height, content-height);
    // sized to its parts (an unset height would stretch to the window's)
    height: filter-height + chips-height + pins-height + list-height + footer-height;

    // the top of row `i` in the list, its section's title above it
    pure function row-top(i: int) -> length {
        return i * row-height + profiles[i].sections-above * section-height;
    }
    function move-highlight(to: int) {
        if profiles.length == 0 {
            return;
        }
        AwsAccount.highlighted = max(0, min(profiles.length - 1, to));
        let top = row-top(AwsAccount.highlighted) - (profiles[AwsAccount.highlighted].section == "" ? 0px : section-height);
        let bottom = row-top(AwsAccount.highlighted) + row-height;
        if top < -list-flick.content-y {
            list-flick.content-y = -top;
        } else if bottom > -list-flick.content-y + list-flick.height {
            list-flick.content-y = -(bottom - list-flick.height);
        }
    }

    // absorbs clicks on blank space so they don't close the dropdown
    TouchArea { }

    VerticalLayout {
        HorizontalLayout {
            height: filter-height;
            padding-left: Theme.px(8px);
            padding-right: Theme.px(10px);
            padding-top: Theme.px(8px);
            padding-bottom: Theme.px(6px);
            spacing: Theme.px(8px);
            filter-box := SearchField {
                auto-focus: true;
                placeholder: @tr("Filter profiles...");
                font-size: Theme.pt(12px);
                height: Theme.px(26px);
                horizontal-stretch: 1;
                clipboard-has-text() => { return root.clipboard-has-text(); }
                // the list is filtered anew with its first row highlighted: back to the top
                edited => {
                    AwsAccount.list-requested(self.text);
                    list-flick.content-y = 0;
                }
                accepted => {
                    if profiles.length > 0 {
                        root.picked(profiles[AwsAccount.highlighted].name);
                    } else if pins.length > 0 {
                        root.picked(pins[0].name);
                    }
                }
                key-intercept(event) => {
                    if event.text == Key.UpArrow {
                        root.move-highlight(AwsAccount.highlighted - 1);
                        return true;
                    } else if event.text == Key.DownArrow {
                        root.move-highlight(AwsAccount.highlighted + 1);
                        return true;
                    } else if event.text == Key.Escape {
                        root.closed();
                        return true;
                    }
                    return false;
                }
            }
            Text {
                text: AwsAccount.count-label;
                font-size: Theme.pt(11px);
                color: Theme.text-tertiary;
                vertical-alignment: center;
            }
            IconButton {
                box-size: Theme.px(24px);
                y: (parent.height - self.height) / 2;
                hint: @tr("Reload the profiles from the AWS config");
                clicked => { AwsAccount.reload-requested(); }
                IconRefresh { size: Theme.icon-sm; tint: Theme.text-tertiary; }
            }
        }

        if chip-lines > 0: VerticalLayout {
            height: chips-height;
            VerticalLayout {
                padding-left: Theme.px(8px);
                padding-right: Theme.px(10px);
                spacing: chip-gap;
                for line in AwsAccount.chip-lines: HorizontalLayout {
                    height: chip-height;
                    alignment: start;
                    spacing: chip-gap;
                    for c in line: ProfileChip {
                        data: c;
                        on: c.key == AwsAccount.chip;
                        // picked again, a chip lets go: all the profiles are back
                        clicked => {
                            AwsAccount.chip-picked(c.key == AwsAccount.chip ? "" : c.key);
                            AwsAccount.list-requested(filter-box.text);
                            list-flick.content-y = 0;
                        }
                    }
                }
            }
            Rectangle { }
            Rectangle {
                height: 1px;
                background: Theme.border-soft;
            }
        }

        // the pins: two per line, a click picks one, its star unpins it
        if pins.length > 0: Rectangle {
            height: pins-height;
            HorizontalLayout {
                y: 0;
                height: section-height;
                padding-left: Theme.px(12px);
                Text {
                    text: AwsAccount.pins-title;
                    font-size: Theme.pt(10.5px);
                    font-weight: 600;
                    color: Theme.text-tertiary;
                    vertical-alignment: center;
                }
            }
            for p[i] in pins: Rectangle {
                property <length> tile-width: (parent.width - Theme.px(16px) - pin-gap) / 2;
                x: Theme.px(8px) + mod(i, 2) * (tile-width + pin-gap);
                y: section-height + floor(i / 2) * (pin-height + pin-gap);
                width: tile-width;
                height: pin-height;
                border-radius: Theme.radius-sm;
                border-width: 1px;
                border-color: p.name == root.selected ? Theme.accent-blue-dim : Theme.border-soft;
                background: p.name == root.selected ? Theme.bg-selected-soft
                    : (tile-area.has-hover ? Theme.bg-hover-elevated : Theme.bg-hover-elevated.mix(Theme.bg-elevated, 0.3));
                tile-area := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.picked(p.name); }
                }
                HorizontalLayout {
                    padding-left: Theme.px(8px);
                    padding-right: Theme.px(2px);
                    spacing: Theme.px(7px);
                    VerticalLayout {
                        alignment: center;
                        if p.has-tint: TintDot { tint: p.tint; size: Theme.px(7px); }
                        if !p.has-tint: IconDot { size: Theme.px(7px); tint: Theme.text-tertiary; }
                    }
                    Text {
                        text: p.name;
                        font-size: Theme.pt(12px);
                        font-weight: p.name == root.selected ? 700 : 500;
                        color: Theme.text-primary;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                        min-width: 0px;
                    }
                    VerticalLayout {
                        alignment: center;
                        IconButton {
                            box-size: Theme.px(22px);
                            hint: @tr("Unpin");
                            clicked => { AwsAccount.pin-toggled(p.name); }
                            IconStar { size: Theme.px(12px); filled: true; tint: Theme.accent-yellow; }
                        }
                    }
                }
            }
        }

        if profiles.length == 0 && pins.length == 0: Text {
            height: list-height;
            text: @tr("No profile matches");
            color: Theme.text-tertiary;
            font-size: Theme.pt(12px);
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        HorizontalLayout {
            height: profiles.length == 0 ? 0px : list-height;
            list-flick := Flickable {
                horizontal-stretch: 1;
                VerticalLayout {
                    width: list-flick.width;
                    alignment: start;
                    padding-bottom: Theme.px(4px);
                    for p[i] in profiles: VerticalLayout {
                        if p.section != "": HorizontalLayout {
                            height: section-height;
                            padding-left: Theme.px(12px);
                            Text {
                                text: p.section;
                                font-size: Theme.pt(10.5px);
                                font-weight: 600;
                                color: Theme.text-tertiary;
                                vertical-alignment: center;
                            }
                        }
                        Rectangle {
                            height: row-height;
                            row := Rectangle {
                                x: Theme.px(4px);
                                width: parent.width - Theme.px(8px);
                                border-radius: Theme.radius-sm;
                                background: p.name == root.selected ? Theme.bg-selected-soft
                                    : (i == AwsAccount.highlighted || row-area.has-hover ? Theme.bg-hover-elevated : Theme.bg-elevated);
                                row-area := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.picked(p.name); }
                                }
                                HorizontalLayout {
                                    padding-left: Theme.px(8px);
                                    padding-right: Theme.px(6px);
                                    spacing: Theme.px(8px);
                                    Rectangle {
                                        width: Theme.px(14px);
                                        if p.name == root.selected: IconCheck {
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            size: Theme.px(13px);
                                            tint: Theme.accent-blue;
                                        }
                                    }
                                    // one line: the name, its connection profile and SSH tunnel, when it was last used
                                    HorizontalLayout {
                                        horizontal-stretch: 1;
                                        spacing: Theme.px(6px);
                                        Text {
                                            text: p.name;
                                            font-size: Theme.pt(12.5px);
                                            font-weight: p.name == root.selected ? 700 : 500;
                                            color: Theme.text-primary;
                                            overflow: elide;
                                            horizontal-stretch: 1;
                                            min-width: 0px;
                                            vertical-alignment: center;
                                        }
                                        if p.has-tint: TintDot { tint: p.tint; size: Theme.px(7px); y: (parent.height - self.height) / 2; }
                                        if !p.known: IconDot { size: Theme.px(7px); tint: Theme.text-tertiary; y: (parent.height - self.height) / 2; }
                                        if p.profile-label != "": Text {
                                            text: p.profile-label;
                                            font-size: Theme.pt(11px);
                                            color: p.known ? Theme.text-secondary : Theme.text-tertiary;
                                            overflow: elide;
                                            max-width: Theme.px(130px);
                                            vertical-alignment: center;
                                        }
                                        // drawn separator: a "·" glyph may be missing from the UI font
                                        if p.profile-label != "" && p.ssh-label != "": IconDot { size: Theme.px(3px); tint: Theme.text-tertiary; y: (parent.height - self.height) / 2; }
                                        if p.ssh-label != "": Text {
                                            text: p.ssh-label;
                                            font-size: Theme.pt(11px);
                                            color: Theme.text-secondary;
                                            vertical-alignment: center;
                                        }
                                        Rectangle { width: Theme.px(4px); }
                                        Text {
                                            text: p.when;
                                            font-size: Theme.pt(11px);
                                            color: Theme.text-tertiary;
                                            vertical-alignment: center;
                                        }
                                    }
                                    // the star shows on the row under the pointer or the keyboard
                                    VerticalLayout {
                                        alignment: center;
                                        IconButton {
                                            box-size: Theme.px(26px);
                                            hint: @tr("Pin to the top");
                                            opacity: row-area.has-hover || self.hovered || i == AwsAccount.highlighted ? 1 : 0;
                                            clicked => { AwsAccount.pin-toggled(p.name); }
                                            IconStar { size: Theme.icon-sm; tint: Theme.text-secondary; }
                                        }
                                    }
                                    // the gear's room, kept so the times line up
                                    if !p.known: Rectangle { width: Theme.px(26px); }
                                    if p.known: VerticalLayout {
                                        alignment: center;
                                        IconButton {
                                            box-size: Theme.px(26px);
                                            hint: @tr("Account settings");
                                            clicked => { root.settings-clicked(p.name); }
                                            IconSettings { size: Theme.icon-sm; tint: Theme.text-secondary; }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            if list-flick.content-height > list-flick.height: VScrollBar {
                content-height: list-flick.content-height;
                content-y <=> list-flick.content-y;
            }
        }

        Rectangle {
            height: footer-height;
            Rectangle {
                y: 0;
                height: 1px;
                background: Theme.border-soft;
            }
            sign-out := Rectangle {
                x: Theme.px(4px);
                y: (parent.height - self.height) / 2;
                width: sign-out-label.preferred-width + Theme.px(16px);
                height: Theme.px(26px);
                border-radius: Theme.radius-sm;
                background: sign-out-area.has-hover ? Theme.bg-hover-elevated : transparent;
                sign-out-area := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.sign-out-clicked(); }
                }
                sign-out-label := Text {
                    x: Theme.px(8px);
                    text: @tr("Sign out of AWS");
                    font-size: Theme.pt(12px);
                    color: sign-out-area.has-hover ? Theme.text-primary : Theme.text-secondary;
                    vertical-alignment: center;
                }
            }
            // until something is pinned: how to
            if !AwsAccount.has-pinned && profiles.length > 0: Text {
                width: min(self.preferred-width, parent.width - sign-out.width - Theme.px(24px));
                x: parent.width - self.width - Theme.px(10px);
                height: parent.height;
                overflow: elide;
                text: @tr("Click a profile's star to pin it at the top");
                font-size: Theme.pt(11px);
                color: Theme.text-tertiary;
                vertical-alignment: center;
            }
        }
    }
}
