import { Theme } from "theme.slint";
import { LanguageSetting, OpeningView, SettingsCategory, ProfileTint, SshProfileRowData, SshProfileForm, ConnProfileForm } from "types.slint";
import { VScrollBar, ModalButton, CheckRow, SegmentedToggle, IconButton, PastePopup } from "widgets.slint";
import { IconPlus, IconPencil, IconSettings, IconKey, IconPalette, IconFlask, IconInfo, IconKeyboard, IconUndo, IconSearch, IconClose } from "icons.slint";
import { ConnectionModalField, ConnProfileRowData, TintDot } from "connection-picker.slint";
import { Preferences, About, Shortcuts } from "../globals.slint";
export { SshProfileRowData, SshProfileForm, ConnProfileForm }

// one choice of a row of exclusive options (the language)
component SegmentButton inherits Rectangle {
    in property <string> text;
    in property <bool> selected: false;
    callback clicked <=> area.clicked;

    width: label.preferred-width + Theme.px(28px);
    height: Theme.px(28px);
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: selected ? Theme.accent-blue : Theme.border-soft;
    background: selected ? Theme.accent-blue.with-alpha(0.18) : (area.has-hover ? Theme.bg-hover : transparent);

    area := TouchArea { mouse-cursor: pointer; }
    label := Text {
        text: root.text;
        color: selected ? Theme.accent-blue : Theme.text-secondary;
        font-weight: selected ? 600 : 400;
        font-size: Theme.pt(12px);
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
    }
}

component ProfileRow inherits Rectangle {
    in property <string> name;
    in property <string> username;
    in property <bool> active;
    // set by the list to its own width, like ConnectionRow's `row-width`
    in property <length> row-width;
    callback activate();
    callback edit();

    width: row-width;
    height: Theme.px(46px);
    // opaque at rest (the list box's color): a hover change only redraws the row, which then covers its own area
    background: row-area.has-hover ? Theme.bg-hover-elevated : Theme.bg-sunken;

    row-area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.activate(); }

        HorizontalLayout {
            padding-left: Theme.px(12px);
            padding-right: Theme.px(8px);
            spacing: Theme.px(10px);
            cross-axis-alignment: center;

            // radio: the profile the SSH connections without a login use
            Rectangle {
                width: Theme.px(16px);
                height: Theme.px(16px);
                border-radius: self.width / 2;
                border-width: 1.5px;
                border-color: root.active ? Theme.accent-blue : Theme.text-tertiary;
                if root.active: Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: Theme.px(8px);
                    height: Theme.px(8px);
                    border-radius: self.width / 2;
                    background: Theme.accent-blue;
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: Theme.px(1px);
                Text {
                    text: root.name;
                    font-size: Theme.pt(12px);
                    font-weight: 600;
                    color: Theme.text-primary;
                    overflow: elide;
                }
                Text {
                    text: root.username;
                    font-size: Theme.pt(11px);
                    font-family: Theme.font-mono;
                    color: Theme.text-tertiary;
                    overflow: elide;
                }
            }
            if root.active: Rectangle {
                width: active-label.preferred-width + Theme.px(14px);
                height: Theme.px(18px);
                border-radius: self.height / 2;
                background: Theme.accent-blue.with-alpha(0.18);
                active-label := Text {
                    text: @tr("Active");
                    font-size: Theme.pt(10.5px);
                    font-weight: 600;
                    color: Theme.accent-blue;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: 100%;
                    height: 100%;
                }
            }
            edit-area := Rectangle {
                width: Theme.px(24px);
                height: Theme.px(24px);
                border-radius: Theme.radius-sm;
                background: edit-touch.has-hover ? Theme.bg-hover : transparent;
                IconPencil {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    size: Theme.icon-sm;
                    tint: Theme.text-tertiary;
                }
                edit-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.edit(); }
                }
            }
        }
    }
}

// "+ Add ..." at the right of a section's title
component AddLink inherits Rectangle {
    in property <string> text;
    callback clicked <=> add-area.clicked;

    width: add-row.preferred-width + Theme.px(20px);
    height: Theme.px(24px);
    border-radius: Theme.radius-sm;
    background: add-area.has-hover ? Theme.bg-hover : transparent;
    add-area := TouchArea { mouse-cursor: pointer; }
    add-row := HorizontalLayout {
        x: Theme.px(10px);
        width: parent.width - Theme.px(20px);
        spacing: Theme.px(6px);
        cross-axis-alignment: center;
        IconPlus { size: Theme.icon-sm; tint: Theme.accent-blue; }
        Text {
            text: root.text;
            color: Theme.accent-blue;
            font-size: Theme.pt(12px);
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}

// one connection profile in the settings list: click to edit it
component ConnProfileRow inherits Rectangle {
    in property <string> name;
    in property <ProfileTint> tint;
    in property <bool> read-only: false;
    in property <length> row-width;
    callback edit();

    width: row-width;
    height: Theme.px(34px);
    // opaque at rest (the list box's color), like ProfileRow
    background: row-area.has-hover ? Theme.bg-hover-elevated : Theme.bg-sunken;

    row-area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.edit(); }

        HorizontalLayout {
            padding-left: Theme.px(12px);
            padding-right: Theme.px(8px);
            spacing: Theme.px(10px);
            cross-axis-alignment: center;
            TintDot { tint: root.tint; size: Theme.px(14px); }
            Text {
                text: root.name;
                font-size: Theme.pt(12px);
                font-weight: 600;
                color: Theme.text-primary;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            if root.read-only: Text {
                text: @tr("Read-only");
                font-size: Theme.pt(10.5px);
                color: Theme.text-tertiary;
                vertical-alignment: center;
            }
            IconPencil { size: Theme.icon-sm; tint: Theme.text-tertiary; }
        }
    }
}

// the eight tints to choose from, the chosen one ringed
component TintSwatches inherits HorizontalLayout {
    in-out property <ProfileTint> tint: ProfileTint.red;
    property <[ProfileTint]> tints: [
        ProfileTint.red, ProfileTint.orange, ProfileTint.yellow, ProfileTint.green,
        ProfileTint.cyan, ProfileTint.blue, ProfileTint.purple, ProfileTint.pink,
    ];

    alignment: start;
    spacing: Theme.px(8px);
    for t in root.tints: Rectangle {
        width: Theme.px(26px);
        height: Theme.px(26px);
        border-radius: self.width / 2;
        border-width: 2px;
        border-color: root.tint == t ? Theme.text-primary : (swatch-area.has-hover ? Theme.text-tertiary : transparent);
        TintDot {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            tint: t;
            size: Theme.px(16px);
        }
        swatch-area := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.tint = t; }
        }
    }
}


// the icon of a settings category, or the search's magnifier for its results (`results`)
component CategoryIcon inherits Rectangle {
    in property <SettingsCategory> category;
    in property <bool> results: false;
    in property <color> tint;

    width: Theme.icon-md;
    height: Theme.icon-md;
    if root.results: IconSearch { size: Theme.icon-md; tint: root.tint; }
    if !root.results && root.category == SettingsCategory.general: IconSettings { size: Theme.icon-md; tint: root.tint; }
    if !root.results && root.category == SettingsCategory.key-bindings: IconKeyboard { size: Theme.icon-md; tint: root.tint; }
    if !root.results && root.category == SettingsCategory.ssh-profiles: IconKey { size: Theme.icon-md; tint: root.tint; }
    if !root.results && root.category == SettingsCategory.conn-profiles: IconPalette { size: Theme.icon-md; tint: root.tint; }
    if !root.results && root.category == SettingsCategory.experimental: IconFlask { size: Theme.icon-md; tint: root.tint; }
    if !root.results && root.category == SettingsCategory.about: IconInfo { size: Theme.icon-md; tint: root.tint; }
}

// one entry of the left column of the settings window: a category, or the search's results
component CategoryItem inherits Rectangle {
    in property <SettingsCategory> category;
    in property <bool> results: false;
    in property <string> text;
    in property <bool> selected: false;
    callback clicked <=> area.clicked;

    height: Theme.px(32px);
    border-radius: Theme.radius-md;
    background: selected ? Theme.bg-selected-soft : (area.has-hover ? Theme.bg-hover : transparent);

    area := TouchArea { mouse-cursor: pointer; }
    HorizontalLayout {
        padding-left: Theme.px(10px);
        padding-right: Theme.px(10px);
        spacing: Theme.px(10px);
        cross-axis-alignment: center;
        CategoryIcon {
            category: root.category;
            results: root.results;
            tint: root.selected ? Theme.accent-blue : Theme.text-tertiary;
        }
        Text {
            text: root.text;
            font-size: Theme.pt(12px);
            font-weight: root.selected ? 600 : 400;
            color: root.selected ? Theme.text-primary : Theme.text-secondary;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
    }
}

// a setting's name, in bold above its control
component SettingTitle inherits Text {
    font-size: Theme.pt(12px);
    font-weight: 600;
    color: Theme.text-primary;
}

// the gray explanation under a setting; wrapped text needs its height set (2 lines by default)
component SettingHint inherits Text {
    height: Theme.pt(28px);
    font-size: Theme.pt(10.5px);
    color: Theme.text-tertiary;
    wrap: word-wrap;
}

// a key combination, drawn as a key cap
component KeyCap inherits Rectangle {
    in property <string> text;
    in property <bool> muted: false;
    in property <bool> waiting: false;

    width: cap-label.preferred-width + Theme.px(14px);
    height: Theme.px(22px);
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: root.waiting ? Theme.accent-blue : Theme.border-soft;
    background: root.waiting ? Theme.accent-blue.with-alpha(0.12) : Theme.bg-sunken;
    cap-label := Text {
        text: root.text;
        font-size: Theme.pt(11px);
        font-family: root.waiting ? Theme.font-ui : Theme.font-mono;
        color: root.waiting ? Theme.accent-blue : (root.muted ? Theme.text-tertiary : Theme.text-primary);
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
    }
}

// one shortcut of the Key bindings page: a click waits for new keys (`recording`), which reach
// `pressed` until Esc, a click elsewhere or Rust ends it; the arrow restores the default keys
component ShortcutLine inherits Rectangle {
    in property <string> title;
    in property <[string]> keys;
    in property <bool> custom: false;
    in property <bool> recording: false;
    // a standard key, shown but never changed
    in property <bool> fixed: false;
    callback start();
    callback cancel();
    callback pressed(event: KeyEvent);
    callback reset();

    height: Theme.px(32px);
    border-radius: Theme.radius-md;
    background: root.recording ? Theme.accent-blue.with-alpha(0.08) : (line-area.has-hover && !root.fixed ? Theme.bg-hover : transparent);

    line-area := TouchArea {
        enabled: !root.fixed;
        mouse-cursor: root.fixed ? MouseCursor.default : MouseCursor.pointer;
        clicked => { root.start(); }
    }
    HorizontalLayout {
        padding-left: Theme.px(10px);
        padding-right: Theme.px(4px);
        spacing: Theme.px(6px);
        alignment: stretch;
        Text {
            text: root.title;
            font-size: Theme.pt(12px);
            color: root.fixed ? Theme.text-secondary : Theme.text-primary;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        if root.recording: VerticalLayout {
            alignment: center;
            KeyCap { text: @tr("Press the new keys..."); waiting: true; }
        }
        if !root.recording: HorizontalLayout {
            spacing: Theme.px(4px);
            for k in root.keys: VerticalLayout {
                alignment: center;
                KeyCap { text: k; muted: root.fixed; }
            }
        }
        // always there, so the key caps of every line end at the same place
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: Theme.px(24px);
                height: Theme.px(24px);
                border-radius: Theme.radius-sm;
                background: root.custom && reset-area.has-hover ? Theme.bg-hover-elevated : transparent;
                if root.custom: IconUndo {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    size: Theme.icon-sm;
                    tint: Theme.text-tertiary;
                }
                reset-area := TouchArea {
                    enabled: root.custom;
                    mouse-cursor: root.custom ? MouseCursor.pointer : MouseCursor.default;
                    clicked => { root.reset(); }
                }
            }
        }
    }
    if root.recording: FocusScope {
        init => { self.focus(); }
        changed has-focus => {
            if !self.has-focus {
                root.cancel();
            }
        }
        key-pressed(event) => {
            root.pressed(event);
            accept
        }
        key-released(event) => { accept }
    }
}

// the settings' search box, above the categories: it filters them as it's typed; the × or Esc empties it
component SettingsSearch inherits Rectangle {
    in-out property <string> text;
    callback clipboard-has-text() -> bool;

    height: Theme.px(28px);
    background: Theme.bg-sunken;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent-blue-dim : Theme.border;
    HorizontalLayout {
        padding-left: Theme.px(8px);
        padding-right: Theme.px(3px);
        spacing: Theme.px(6px);
        IconSearch { size: Theme.icon-sm; tint: Theme.text-tertiary; y: (parent.height - self.height) / 2; }
        // the text scrolls to keep the cursor visible, like the other inputs
        Rectangle {
            horizontal-stretch: 1;
            min-width: 0px;
            clip: true;

            if root.text == "" && !input.has-focus: Text {
                text: @tr("Search settings");
                font-size: Theme.pt(12px);
                color: Theme.text-tertiary;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
                overflow: elide;
            }
            touch := TouchArea {
                width: 100%;
                height: 100%;
                mouse-cursor: MouseCursor.text;
                property <length> click-x;
                property <length> click-y;
                pointer-event(event) => {
                    if event.button == PointerEventButton.right && event.kind == PointerEventKind.down && root.clipboard-has-text() {
                        self.click-x = self.mouse-x;
                        self.click-y = self.mouse-y;
                        paste-popup.show();
                    }
                }
                input := TextInput {
                    property <length> computed-x;
                    x: min(0px, max(parent.width - self.width, self.computed-x));
                    width: max(parent.width, self.preferred-width);
                    height: 100%;
                    text <=> root.text;
                    single-line: true;
                    font-size: Theme.pt(12px);
                    color: Theme.text-primary;
                    selection-background-color: Theme.accent-blue.with-alpha(0.35);
                    vertical-alignment: center;
                    key-pressed(event) => {
                        if event.text == Key.Escape && self.text != "" {
                            root.text = "";
                            return accept;
                        }
                        return reject;
                    }
                    cursor-position-changed(cursor-position) => {
                        if cursor-position.x + self.computed-x < 0px {
                            self.computed-x = -cursor-position.x;
                        } else if cursor-position.x + self.computed-x > parent.width - self.text-cursor-width {
                            self.computed-x = parent.width - cursor-position.x - self.text-cursor-width;
                        }
                    }
                }
                paste-popup := PastePopup {
                    x: touch.click-x;
                    y: touch.click-y;
                    paste => { input.paste(); }
                }
            }
        }
        if root.text != "": IconButton {
            box-size: Theme.px(20px);
            y: (parent.height - self.height) / 2;
            clicked => { root.text = ""; }
            IconClose { size: Theme.icon-sm; tint: Theme.text-tertiary; }
        }
    }
}

// a page of settings that scrolls once it's taller than the window leaves it
component SettingsPage inherits HorizontalLayout {
    vertical-stretch: 1;
    page-flick := Flickable {
        horizontal-stretch: 1;
        interactive: true;
        VerticalLayout {
            // a Flickable's content isn't sized by its frame; the margin keeps text off the bar
            width: page-flick.width - Theme.px(12px);
            alignment: start;
            spacing: Theme.px(20px);
            @children
        }
    }
    VScrollBar {
        content-height: page-flick.content-height;
        content-y <=> page-flick.content-y;
    }
}

// the explanations under the settings, which the search reads too
global SettingTexts {
    out property <string> depth-hint: @tr("How many entries of each key (hash fields, list items, set members...) the global search reads. Fewer is faster, but a match deeper inside a big key is missed.");
    out property <string> opening-view-hint: @tr("The view a key shows when its tab opens. A query's result always opens as a table, and a search hit or a link to a field in the fields view.");
    out property <string> restore-hint: @tr("Cachemire reconnects to the connection it was closed on, with its tabs and open folders. An AWS connection signs in again first, in the browser if its session has expired.");
    out property <string> updates-hint: @tr("Each time Cachemire starts, it looks for a newer version on the channel picked in About (the i button of the title bar), and opens it when there is one.");
    out property <string> server-search-hint: @tr("The global search lets Redis filter the data itself, so far less of it travels. It uses the server's CPU while it runs, needs permission to run scripts, and goes back to the normal search if the server refuses.");
    out property <string> ssh-hint: @tr("The active profile logs in to the SSH tunnels that have no username of their own. A connection that fills in its own username and password uses those instead.");
    out property <string> host-keys-hint: @tr("An SSH server whose host key isn't in the app's list or in ~/.ssh/known_hosts is normally shown with its fingerprint for you to trust. Turn this on to trust and remember it without asking; a key that changes is always refused.");
    out property <string> conn-hint: @tr("A connection that has one of these profiles tints the app's background while you are connected to it, to tell environments apart.");
}

// one category's part of the search's results: its name over what was found in it,
// with "+ Add ..." at the right of the name when `add-text` isn't empty
component ResultSection inherits VerticalLayout {
    in property <SettingsCategory> category;
    in property <string> text;
    in property <string> add-text;
    callback add();

    spacing: Theme.px(12px);
    padding-bottom: Theme.px(8px);
    VerticalLayout {
        spacing: Theme.px(6px);
        HorizontalLayout {
            height: Theme.px(24px);
            spacing: Theme.px(8px);
            VerticalLayout {
                alignment: center;
                CategoryIcon { category: root.category; tint: Theme.text-secondary; }
            }
            Text {
                text: root.text;
                font-size: Theme.pt(13px);
                font-weight: 700;
                color: Theme.text-primary;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            if root.add-text != "": AddLink {
                text: root.add-text;
                clicked => { root.add(); }
            }
        }
        Rectangle { height: 1px; background: Theme.border-soft; }
    }
    @children
}

// the General page's settings, each hidden when its `show-` is false (not found by the search)
component GeneralSettings inherits VerticalLayout {
    in property <bool> show-language: true;
    in property <bool> show-export: true;
    in property <bool> show-opening-view: true;
    in property <bool> show-depth: true;
    in property <bool> show-restore: true;
    in property <bool> show-check-updates: true;

    spacing: Theme.px(20px);
    if root.show-language: VerticalLayout {
        spacing: Theme.px(6px);
        SettingTitle { text: @tr("Language"); }
        // each language is named in itself, so it can be found from
        // any other one
        HorizontalLayout {
            alignment: start;
            spacing: Theme.px(6px);
            SegmentButton { text: @tr("Automatic"); selected: Preferences.language == LanguageSetting.automatic; clicked => { Preferences.language-selected(LanguageSetting.automatic); } }
            SegmentButton { text: "English"; selected: Preferences.language == LanguageSetting.english; clicked => { Preferences.language-selected(LanguageSetting.english); } }
            SegmentButton { text: "Français"; selected: Preferences.language == LanguageSetting.french; clicked => { Preferences.language-selected(LanguageSetting.french); } }
        }
    }

    if root.show-export: VerticalLayout {
        spacing: Theme.px(6px);
        SettingTitle { text: @tr("Export format"); }
        // what the export buttons start on (they can be switched there)
        HorizontalLayout {
            alignment: start;
            spacing: Theme.px(6px);
            SegmentButton { text: @tr("JSON"); selected: !Preferences.export-escaped; clicked => { Preferences.export-escaped-selected(false); } }
            SegmentButton { text: @tr("Escaped JSON"); selected: Preferences.export-escaped; clicked => { Preferences.export-escaped-selected(true); } }
        }
    }

    if root.show-opening-view: VerticalLayout {
        spacing: Theme.px(6px);
        SettingTitle { text: @tr("New tabs open in"); }
        HorizontalLayout {
            alignment: start;
            spacing: Theme.px(6px);
            SegmentButton { text: @tr("Fields view"); selected: Preferences.opening-view == OpeningView.fields; clicked => { Preferences.opening-view-selected(OpeningView.fields); } }
            SegmentButton { text: @tr("Table view"); selected: Preferences.opening-view == OpeningView.table; clicked => { Preferences.opening-view-selected(OpeningView.table); } }
            SegmentButton { text: @tr("Last view picked"); selected: Preferences.opening-view == OpeningView.last; clicked => { Preferences.opening-view-selected(OpeningView.last); } }
        }
        SettingHint { text: SettingTexts.opening-view-hint; }
    }

    if root.show-depth: VerticalLayout {
        spacing: Theme.px(6px);
        SettingTitle { text: @tr("Search depth"); }
        HorizontalLayout {
            alignment: start;
            spacing: Theme.px(6px);
            SegmentButton { text: "60"; selected: Preferences.search-depth == 60; clicked => { Preferences.search-depth-selected(60); } }
            SegmentButton { text: "200"; selected: Preferences.search-depth == 200; clicked => { Preferences.search-depth-selected(200); } }
            SegmentButton { text: "1000"; selected: Preferences.search-depth == 1000; clicked => { Preferences.search-depth-selected(1000); } }
        }
        SettingHint { text: SettingTexts.depth-hint; }
    }

    if root.show-restore || root.show-check-updates: VerticalLayout {
        spacing: Theme.px(4px);
        SettingTitle { text: @tr("Startup"); }
        if root.show-restore: VerticalLayout {
            spacing: Theme.px(4px);
            CheckRow {
                text: @tr("Restore the last connection");
                checked: Preferences.restore-session;
                toggled => { Preferences.restore-session-toggled(!Preferences.restore-session); }
            }
            SettingHint { text: SettingTexts.restore-hint; }
        }
        if root.show-check-updates: VerticalLayout {
            spacing: Theme.px(4px);
            CheckRow {
                text: @tr("Check for Updates at startup");
                checked: Preferences.check-updates-at-startup;
                toggled => { Preferences.check-updates-at-startup-toggled(!Preferences.check-updates-at-startup); }
            }
            SettingHint { text: SettingTexts.updates-hint; }
        }
    }
}

// the Key bindings page's shortcuts, as Rust filtered them (see Shortcuts.filter-changed):
// the app's own, which can be changed, then the standard ones
component KeyBindingSettings inherits VerticalLayout {
    spacing: Theme.px(20px);
    SettingHint {
        text: @tr("Click a shortcut, then press the keys to use instead: Ctrl with a key, or a function key alone. Esc cancels.");
    }
    if Shortcuts.rows.length > 0: VerticalLayout {
        spacing: Theme.px(2px);
        for row[index] in Shortcuts.rows: VerticalLayout {
            padding-top: row.group-title != "" && index > 0 ? Theme.px(14px) : 0;
            spacing: Theme.px(4px);
            if row.group-title != "": SettingTitle { text: row.group-title; }
            ShortcutLine {
                title: row.title;
                keys: row.keys;
                custom: row.custom;
                recording: Shortcuts.recording && Shortcuts.recording-action == row.action;
                start => {
                    Preferences.error = "";
                    Shortcuts.recording-action = row.action;
                    Shortcuts.recording = true;
                }
                cancel => {
                    if Shortcuts.recording-action == row.action {
                        Shortcuts.recording = false;
                    }
                }
                pressed(event) => {
                    if event.text == Key.Escape {
                        Shortcuts.recording = false;
                    } else {
                        Shortcuts.recorded(row.action, event.text, event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta);
                    }
                }
                reset => {
                    Preferences.error = "";
                    Shortcuts.recording = false;
                    Shortcuts.reset(row.action);
                }
            }
        }
    }

    if Shortcuts.standard.length > 0: VerticalLayout {
        spacing: Theme.px(2px);
        SettingTitle { text: @tr("Standard keys"); }
        SettingHint {
            height: Theme.pt(18px);
            text: @tr("They work as in other apps, and can't be changed.");
        }
        for line in Shortcuts.standard: ShortcutLine {
            fixed: true;
            title: line.title;
            keys: line.keys;
        }
    }
}

// the Experimental page's one setting
component ExperimentalSettings inherits VerticalLayout {
    spacing: Theme.px(4px);
    CheckRow {
        text: @tr("Search on the server (Lua script)");
        checked: Preferences.server-search;
        toggled => { Preferences.server-search-toggled(!Preferences.server-search); }
    }
    SettingHint {
        text: SettingTexts.server-search-hint;
        height: Theme.pt(42px);
    }
}

// the About page: the version and the repository, then the updates, each hidden when its
// `show-` is false (not found by the search)
component AboutSettings inherits VerticalLayout {
    in property <bool> show-version: true;
    in property <bool> show-updates: true;

    spacing: Theme.px(20px);
    if root.show-version: HorizontalLayout {
        spacing: Theme.px(14px);
        alignment: start;
        Image {
            source: @image-url("../../../../resources/icon.png");
            width: Theme.px(48px);
            height: Theme.px(48px);
        }
        VerticalLayout {
            alignment: center;
            spacing: Theme.px(2px);
            Text {
                text: "Cachemire by Léo Parent";
                font-size: Theme.pt(14px);
                font-weight: 700;
                color: Theme.text-primary;
            }
            Text {
                text: About.version;
                font-size: Theme.pt(12.5px);
                color: Theme.text-secondary;
            }
            HorizontalLayout {
                alignment: start;
                Text {
                    text: @tr("GitHub repository");
                    font-size: Theme.pt(12px);
                    color: Theme.accent-blue;
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { About.open-repo(); }
                    }
                }
            }
        }
    }

    if root.show-updates: VerticalLayout {
        spacing: Theme.px(8px);
        SettingTitle { text: @tr("Updates"); }
        HorizontalLayout {
            alignment: start;
            SegmentedToggle {
                options: [@tr("Stable"), @tr("Beta")];
                segment-width: Theme.px(64px);
                current: About.channel;
                picked(index) => { if (!About.busy && index != About.channel) { About.channel-picked(index); } }
            }
        }
        HorizontalLayout {
            alignment: start;
            spacing: Theme.px(8px);
            ModalButton {
                text: About.busy ? @tr("Checking...") : @tr("Check for updates");
                clicked => { if (!About.busy) { About.check(); } }
            }
            if About.update-available: ModalButton {
                text: About.download-label;
                primary: true;
                clicked => { if (!About.busy) { About.download(); } }
            }
        }
        if About.status != "": Text {
            // a layout can't tell how far wrapped text grows: about 60 characters a line
            height: Theme.pt(16px) * max(1, ceil(self.text.character-count / 60));
            text: About.status;
            font-size: Theme.pt(12px);
            color: Theme.text-secondary;
            wrap: word-wrap;
        }
    }
}

// the SSH profiles under their hint: on their own page (`scrolls`) the list grows with its
// rows and scrolls once the page is full; in the search's results it shows every row
component SshProfileList inherits VerticalLayout {
    in property <bool> scrolls: true;
    callback edit(id: string, name: string, username: string);
    property <[SshProfileRowData]> profiles: Preferences.ssh-profiles;
    property <length> row-height: Theme.px(46px);

    spacing: Theme.px(12px);
    SettingHint { text: SettingTexts.ssh-hint; }
    VerticalLayout {
        spacing: Theme.px(4px);
        CheckRow {
            text: @tr("Accept new SSH host keys automatically");
            checked: Preferences.accept-new-ssh-host-keys;
            toggled => { Preferences.accept-new-ssh-host-keys-toggled(!Preferences.accept-new-ssh-host-keys); }
        }
        SettingHint { text: SettingTexts.host-keys-hint; }
    }
    list-box := Rectangle {
        property <length> full-height: (root.profiles.length == 0 ? Theme.px(64px) : root.profiles.length * root.row-height) + Theme.px(2px);
        min-height: root.scrolls ? min(self.full-height, root.row-height + Theme.px(2px)) : self.full-height;
        preferred-height: self.full-height;
        max-height: self.full-height;
        vertical-stretch: 1;
        background: Theme.bg-sunken;
        border-radius: Theme.radius-md;
        border-width: 1px;
        border-color: Theme.border-soft;

        if root.profiles.length == 0: Text {
            text: @tr("No SSH profiles yet");
            font-size: Theme.pt(12px);
            color: Theme.text-tertiary;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        if root.profiles.length > 0 && root.scrolls: HorizontalLayout {
            padding: Theme.px(1px);
            list-flick := Flickable {
                horizontal-stretch: 1;
                interactive: true;
                list-content := VerticalLayout {
                    // pinned to the box's width (less its border):
                    // a Flickable's content isn't sized by its frame
                    width: list-box.width - Theme.px(2px);
                    alignment: start;
                    for p in root.profiles: ProfileRow {
                        row-width: list-content.width;
                        name: p.name;
                        username: p.username;
                        active: p.active;
                        activate => { Preferences.ssh-profile-activated(p.id); }
                        edit => { root.edit(p.id, p.name, p.username); }
                    }
                }
            }
            VScrollBar {
                content-height: list-flick.content-height;
                content-y <=> list-flick.content-y;
            }
        }
        if root.profiles.length > 0 && !root.scrolls: VerticalLayout {
            padding: Theme.px(1px);
            for p in root.profiles: ProfileRow {
                row-width: list-box.width - Theme.px(2px);
                name: p.name;
                username: p.username;
                active: p.active;
                activate => { Preferences.ssh-profile-activated(p.id); }
                edit => { root.edit(p.id, p.name, p.username); }
            }
        }
    }
    if root.scrolls: Rectangle { vertical-stretch: 1; }
}

// the connection profiles under their hint, laid out like SshProfileList
component ConnProfileList inherits VerticalLayout {
    in property <bool> scrolls: true;
    callback edit(id: string, name: string, tint: ProfileTint, read-only: bool);
    property <[ConnProfileRowData]> profiles: Preferences.conn-profiles;
    property <length> row-height: Theme.px(34px);

    spacing: Theme.px(12px);
    SettingHint { text: SettingTexts.conn-hint; }
    conn-list-box := Rectangle {
        property <length> full-height: (root.profiles.length == 0 ? Theme.px(52px) : root.profiles.length * root.row-height) + Theme.px(2px);
        min-height: root.scrolls ? min(self.full-height, root.row-height + Theme.px(2px)) : self.full-height;
        preferred-height: self.full-height;
        max-height: self.full-height;
        vertical-stretch: 1;
        background: Theme.bg-sunken;
        border-radius: Theme.radius-md;
        border-width: 1px;
        border-color: Theme.border-soft;

        if root.profiles.length == 0: Text {
            text: @tr("No connection profiles yet");
            font-size: Theme.pt(12px);
            color: Theme.text-tertiary;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        if root.profiles.length > 0 && root.scrolls: HorizontalLayout {
            padding: Theme.px(1px);
            conn-flick := Flickable {
                horizontal-stretch: 1;
                interactive: true;
                conn-content := VerticalLayout {
                    width: conn-list-box.width - Theme.px(2px);
                    alignment: start;
                    for p in root.profiles: ConnProfileRow {
                        row-width: conn-content.width;
                        name: p.name;
                        tint: p.tint;
                        read-only: p.read-only;
                        edit => { root.edit(p.id, p.name, p.tint, p.read-only); }
                    }
                }
            }
            VScrollBar {
                content-height: conn-flick.content-height;
                content-y <=> conn-flick.content-y;
            }
        }
        if root.profiles.length > 0 && !root.scrolls: VerticalLayout {
            padding: Theme.px(1px);
            for p in root.profiles: ConnProfileRow {
                row-width: conn-list-box.width - Theme.px(2px);
                name: p.name;
                tint: p.tint;
                read-only: p.read-only;
                edit => { root.edit(p.id, p.name, p.tint, p.read-only); }
            }
        }
    }
    if root.scrolls: Rectangle { vertical-stretch: 1; }
}

// The settings window: its categories on the left, the settings of the one picked on the
// right, where the add/edit form of an SSH or connection profile replaces the list.
// Passwords are never shown; blank keeps the stored one.
export component SettingsModal inherits Rectangle {
    // whether the clipboard holds text, for each field's right-click "Paste"
    callback clipboard-has-text() -> bool;
    in property <string> error: Preferences.error;
    in-out property <SettingsCategory> category <=> Preferences.category;
    // the SSH profile form is showing instead of the list
    in-out property <bool> editing <=> Preferences.ssh-profile-editing;
    in-out property <string> field-id <=> Preferences.ssh-profile-id;
    in-out property <string> field-name <=> Preferences.ssh-profile-name;
    in-out property <string> field-username <=> Preferences.ssh-profile-username;
    in-out property <string> field-password <=> Preferences.ssh-profile-password;
    callback save();
    save => { Preferences.ssh-profile-saved({ id: field-id, name: field-name, username: field-username, password: field-password }); }
    callback delete();
    delete => { Preferences.ssh-profile-deleted(field-id); }
    callback close();
    close => {
        Shortcuts.recording = false;
        Preferences.open = false;
    }
    // the connection profile form is showing instead of the list
    in-out property <bool> editing-conn-profile <=> Preferences.conn-profile-editing;
    in-out property <string> conn-field-id <=> Preferences.conn-profile-id;
    in-out property <string> conn-field-name <=> Preferences.conn-profile-name;
    in-out property <ProfileTint> conn-field-tint <=> Preferences.conn-profile-tint;
    in-out property <bool> conn-field-read-only <=> Preferences.conn-profile-read-only;
    callback conn-save();
    conn-save => {
        Preferences.conn-profile-saved({ id: conn-field-id, name: conn-field-name, tint: conn-field-tint, read-only: conn-field-read-only });
    }
    callback conn-delete();
    conn-delete => { Preferences.conn-profile-deleted(conn-field-id); }

    // the search box's text: while there is some, the Settings found page replaces the
    // categories, with what it finds in each of them under their names
    property <string> query;
    property <bool> searching: root.query != "";
    pure function hit(text: string) -> bool {
        return root.query == "" || Preferences.search-matches(root.query, text);
    }
    // each setting is found by its page's name and its own texts
    property <bool> found-language: root.hit(@tr("General") + " " + @tr("Language") + " " + @tr("Automatic") + " English Français");
    property <bool> found-export: root.hit(@tr("General") + " " + @tr("Export format") + " " + @tr("JSON") + " " + @tr("Escaped JSON"));
    property <bool> found-opening-view: root.hit(@tr("General") + " " + @tr("New tabs open in") + " " + @tr("Fields view") + " " + @tr("Table view") + " " + @tr("Last view picked") + " " + SettingTexts.opening-view-hint);
    property <bool> found-depth: root.hit(@tr("General") + " " + @tr("Search depth") + " 60 200 1000 " + SettingTexts.depth-hint);
    property <bool> found-restore: root.hit(@tr("General") + " " + @tr("Startup") + " " + @tr("Restore the last connection") + " " + SettingTexts.restore-hint);
    property <bool> found-check-updates: root.hit(@tr("General") + " " + @tr("Startup") + " " + @tr("Check for Updates at startup") + " " + SettingTexts.updates-hint);
    property <bool> found-server-search: root.hit(@tr("Experimental") + " " + @tr("Search on the server (Lua script)") + " " + SettingTexts.server-search-hint);
    property <bool> found-version: root.hit(@tr("About") + " Cachemire Léo Parent " + About.version + " " + @tr("GitHub repository"));
    property <bool> found-updates: root.hit(@tr("About") + " " + @tr("Updates") + " " + @tr("Stable") + " " + @tr("Beta") + " " + @tr("Check for updates"));
    property <bool> found-ssh: root.hit(@tr("SSH profiles") + " " + @tr("Add profile") + " " + SettingTexts.ssh-hint + " " + @tr("Accept new SSH host keys automatically") + " " + SettingTexts.host-keys-hint);
    property <bool> found-conn: root.hit(@tr("Connection profiles") + " " + @tr("Add profile") + " " + SettingTexts.conn-hint);
    property <bool> found-any: root.found(SettingsCategory.general) || root.found(SettingsCategory.key-bindings) || root.found(SettingsCategory.ssh-profiles)
        || root.found(SettingsCategory.conn-profiles) || root.found(SettingsCategory.experimental) || root.found(SettingsCategory.about);

    pure function found(category: SettingsCategory) -> bool {
        return category == SettingsCategory.general ? root.found-language || root.found-export || root.found-opening-view || root.found-depth || root.found-restore || root.found-check-updates
            : category == SettingsCategory.key-bindings ? root.query == "" || Shortcuts.rows.length > 0 || Shortcuts.standard.length > 0
            : category == SettingsCategory.ssh-profiles ? root.found-ssh
            : category == SettingsCategory.conn-profiles ? root.found-conn
            : category == SettingsCategory.experimental ? root.found-server-search
            : root.found-version || root.found-updates;
    }

    init => { Shortcuts.filter-changed("", "", ""); }
    changed query => { Shortcuts.filter-changed(root.query, @tr("Key bindings"), @tr("Standard keys")); }
    // starting or ending a search closes an open form, as picking a category does
    changed searching => { root.select(root.category); }

    property <bool> confirming-delete: false;
    property <bool> on-ssh-form: root.editing && (root.searching || root.category == SettingsCategory.ssh-profiles);
    property <bool> on-conn-form: root.editing-conn-profile && (root.searching || root.category == SettingsCategory.conn-profiles);

    function select(category: SettingsCategory) {
        Shortcuts.recording = false;
        root.editing = false;
        root.editing-conn-profile = false;
        root.confirming-delete = false;
        Preferences.error = "";
        root.category = category;
    }

    function show-form(id: string, name: string, username: string) {
        root.field-id = id;
        root.field-name = name;
        root.field-username = username;
        root.field-password = "";
        root.confirming-delete = false;
        root.editing = true;
    }

    function show-conn-form(id: string, name: string, tint: ProfileTint, read-only: bool) {
        root.conn-field-id = id;
        root.conn-field-name = name;
        root.conn-field-tint = tint;
        root.conn-field-read-only = read-only;
        root.confirming-delete = false;
        root.editing-conn-profile = true;
    }

    background: #000000aa;

    TouchArea {
        clicked => { root.close(); }
    }

    // centered by a layout, for the reason given in ConnectionModal
    VerticalLayout {
        alignment: center;
        cross-axis-alignment: center;

        card := Rectangle {
            width: min(Theme.px(780px), root.width - Theme.px(32px));
            height: min(Theme.px(810px), root.height - Theme.px(48px));
            background: Theme.bg-elevated;
            border-radius: Theme.radius-lg;
            border-width: 1px;
            border-color: Theme.border-soft;
            drop-shadow-color: Theme.shadow-color;
            drop-shadow-blur: Theme.shadow-blur;
            drop-shadow-offset-y: Theme.shadow-offset-y;

            // swallow clicks so they don't bubble to the backdrop's close
            TouchArea { }

            // inset by the border, so the column's background leaves it visible
            HorizontalLayout {
                padding: 1px;

                // ---- the categories, or the search's results alone while there is a search
                Rectangle {
                    width: Theme.px(200px);
                    background: Theme.bg-panel;
                    border-top-left-radius: Theme.radius-lg - 1px;
                    border-bottom-left-radius: Theme.radius-lg - 1px;

                    VerticalLayout {
                        padding: Theme.px(12px);
                        padding-top: Theme.px(16px);
                        spacing: Theme.px(2px);

                        HorizontalLayout {
                            padding-left: Theme.px(10px);
                            padding-bottom: Theme.px(10px);
                            Text {
                                text: @tr("Settings");
                                height: Theme.pt(18px);
                                font-size: Theme.pt(14px);
                                font-weight: 700;
                                color: Theme.text-primary;
                                vertical-alignment: center;
                            }
                        }
                        VerticalLayout {
                            padding-bottom: Theme.px(8px);
                            SettingsSearch {
                                text <=> root.query;
                                clipboard-has-text() => { return root.clipboard-has-text(); }
                            }
                        }
                        // back from a profile's form to the results
                        if root.searching: CategoryItem {
                            results: true;
                            text: @tr("Settings found");
                            selected: true;
                            clicked => { root.select(root.category); }
                        }
                        if !root.searching: CategoryItem {
                            category: SettingsCategory.general;
                            text: @tr("General");
                            selected: root.category == self.category;
                            clicked => { root.select(self.category); }
                        }
                        if !root.searching: CategoryItem {
                            category: SettingsCategory.key-bindings;
                            text: @tr("Key bindings");
                            selected: root.category == self.category;
                            clicked => { root.select(self.category); }
                        }
                        if !root.searching: CategoryItem {
                            category: SettingsCategory.ssh-profiles;
                            text: @tr("SSH profiles");
                            selected: root.category == self.category;
                            clicked => { root.select(self.category); }
                        }
                        if !root.searching: CategoryItem {
                            category: SettingsCategory.conn-profiles;
                            text: @tr("Connection profiles");
                            selected: root.category == self.category;
                            clicked => { root.select(self.category); }
                        }
                        if !root.searching: CategoryItem {
                            category: SettingsCategory.experimental;
                            text: @tr("Experimental");
                            selected: root.category == self.category;
                            clicked => { root.select(self.category); }
                        }
                        // About sits apart, at the bottom of the column
                        Rectangle { vertical-stretch: 1; }
                        if !root.searching: CategoryItem {
                            category: SettingsCategory.about;
                            text: @tr("About");
                            selected: root.category == self.category;
                            clicked => { root.select(self.category); }
                        }
                    }
                }
                Rectangle { width: 1px; background: Theme.border-soft; }

                // ---- the page of the category picked, or of the search's results
                VerticalLayout {
                    horizontal-stretch: 1;
                    padding: Theme.px(20px);
                    padding-top: Theme.px(16px);
                    padding-bottom: Theme.px(16px);
                    spacing: Theme.px(12px);

                    HorizontalLayout {
                        height: Theme.px(24px);
                        Text {
                            text: !root.found-any ? ""
                                : root.on-conn-form ? (root.conn-field-id == "" ? @tr("New connection profile") : @tr("Edit connection profile"))
                                : root.on-ssh-form ? (root.field-id == "" ? @tr("New SSH profile") : @tr("Edit SSH profile"))
                                : root.searching ? @tr("Settings found")
                                : root.category == SettingsCategory.key-bindings ? @tr("Key bindings")
                                : root.category == SettingsCategory.ssh-profiles ? @tr("SSH profiles")
                                : root.category == SettingsCategory.conn-profiles ? @tr("Connection profiles")
                                : root.category == SettingsCategory.experimental ? @tr("Experimental")
                                : root.category == SettingsCategory.about ? @tr("About")
                                : @tr("General");
                            font-size: Theme.pt(14px);
                            font-weight: 700;
                            color: Theme.text-primary;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                        if !root.searching && root.category == SettingsCategory.ssh-profiles && !root.on-ssh-form: AddLink {
                            text: @tr("Add profile");
                            clicked => { root.show-form("", "", ""); }
                        }
                        if !root.searching && root.category == SettingsCategory.conn-profiles && !root.on-conn-form: AddLink {
                            text: @tr("Add profile");
                            clicked => { root.show-conn-form("", "", ProfileTint.red, false); }
                        }
                    }

                    if !root.searching && root.category == SettingsCategory.general: SettingsPage {
                        GeneralSettings { }
                    }
                    if !root.searching && root.category == SettingsCategory.key-bindings: SettingsPage {
                        KeyBindingSettings { }
                    }
                    if !root.searching && root.category == SettingsCategory.experimental: SettingsPage {
                        ExperimentalSettings { }
                    }
                    if !root.searching && root.category == SettingsCategory.about: SettingsPage {
                        AboutSettings { }
                    }
                    if !root.searching && root.category == SettingsCategory.ssh-profiles && !root.editing: SshProfileList {
                        vertical-stretch: 1;
                        edit(id, name, username) => { root.show-form(id, name, username); }
                    }
                    if !root.searching && root.category == SettingsCategory.conn-profiles && !root.editing-conn-profile: ConnProfileList {
                        vertical-stretch: 1;
                        edit(id, name, tint, read-only) => { root.show-conn-form(id, name, tint, read-only); }
                    }

                    // ---- the search's results, by category, on one page
                    if root.searching && root.found-any && !root.on-ssh-form && !root.on-conn-form: SettingsPage {
                        if root.found(SettingsCategory.general): ResultSection {
                            category: SettingsCategory.general;
                            text: @tr("General");
                            GeneralSettings {
                                show-language: root.found-language;
                                show-export: root.found-export;
                                show-opening-view: root.found-opening-view;
                                show-depth: root.found-depth;
                                show-restore: root.found-restore;
                                show-check-updates: root.found-check-updates;
                            }
                        }
                        if root.found(SettingsCategory.key-bindings): ResultSection {
                            category: SettingsCategory.key-bindings;
                            text: @tr("Key bindings");
                            KeyBindingSettings { }
                        }
                        if root.found(SettingsCategory.ssh-profiles): ResultSection {
                            category: SettingsCategory.ssh-profiles;
                            text: @tr("SSH profiles");
                            add-text: @tr("Add profile");
                            add => { root.show-form("", "", ""); }
                            SshProfileList {
                                scrolls: false;
                                edit(id, name, username) => { root.show-form(id, name, username); }
                            }
                        }
                        if root.found(SettingsCategory.conn-profiles): ResultSection {
                            category: SettingsCategory.conn-profiles;
                            text: @tr("Connection profiles");
                            add-text: @tr("Add profile");
                            add => { root.show-conn-form("", "", ProfileTint.red, false); }
                            ConnProfileList {
                                scrolls: false;
                                edit(id, name, tint, read-only) => { root.show-conn-form(id, name, tint, read-only); }
                            }
                        }
                        if root.found(SettingsCategory.experimental): ResultSection {
                            category: SettingsCategory.experimental;
                            text: @tr("Experimental");
                            ExperimentalSettings { }
                        }
                        if root.found(SettingsCategory.about): ResultSection {
                            category: SettingsCategory.about;
                            text: @tr("About");
                            AboutSettings {
                                show-version: root.found-version;
                                show-updates: root.found-updates;
                            }
                        }
                    }

                    // ---- the form of one SSH profile
                    if root.on-ssh-form: VerticalLayout {
                        vertical-stretch: 1;
                        alignment: start;
                        spacing: Theme.px(10px);
                        ConnectionModalField {
                            clipboard-has-text() => { return root.clipboard-has-text(); } label: @tr("Name"); placeholder: @tr("Work bastion"); text <=> root.field-name; }
                        ConnectionModalField {
                            clipboard-has-text() => { return root.clipboard-has-text(); } label: @tr("SSH username"); text <=> root.field-username; }
                        ConnectionModalField {
                            clipboard-has-text() => { return root.clipboard-has-text(); }
                            label: @tr("SSH password");
                            placeholder: root.field-id == "" ? "" : @tr("Leave blank to keep current");
                            text <=> root.field-password;
                            is-password: true;
                        }
                    }

                    // ---- the form of one connection profile
                    if root.on-conn-form: VerticalLayout {
                        vertical-stretch: 1;
                        alignment: start;
                        spacing: Theme.px(10px);
                        ConnectionModalField {
                            clipboard-has-text() => { return root.clipboard-has-text(); } label: @tr("Name"); placeholder: "Production"; text <=> root.conn-field-name; }
                        VerticalLayout {
                            spacing: Theme.px(6px);
                            Text {
                                text: @tr("Color");
                                font-size: Theme.pt(10.5px);
                                font-weight: 600;
                                color: Theme.text-secondary;
                            }
                            TintSwatches { tint <=> root.conn-field-tint; }
                        }
                        CheckRow {
                            text: @tr("Read-only");
                            bold: true;
                            checked: root.conn-field-read-only;
                            toggled => { root.conn-field-read-only = !root.conn-field-read-only; }
                        }
                        Text {
                            text: @tr("No key or value can be changed through a connection that has this profile.");
                            font-size: Theme.pt(10.5px);
                            color: Theme.text-tertiary;
                            wrap: word-wrap;
                        }
                    }

                    if !root.found-any: Text {
                        text: @tr("No setting matches “{}”", root.query);
                        vertical-stretch: 1;
                        font-size: Theme.pt(12px);
                        color: Theme.text-tertiary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        wrap: word-wrap;
                    }

                    if error != "": Text {
                        text: error;
                        height: Theme.pt(28px);
                        color: Theme.accent-red;
                        font-size: Theme.pt(11px);
                        wrap: word-wrap;
                    }

                    // ---- the buttons: a form's, or Close
                    HorizontalLayout {
                        height: Theme.px(28px);
                        spacing: Theme.px(8px);
                        // removing is one click to arm, a second to do it
                        if (root.on-ssh-form && root.field-id != "") || (root.on-conn-form && root.conn-field-id != ""): ModalButton {
                            text: root.confirming-delete ? @tr("Click again to delete") : @tr("Delete");
                            danger: true;
                            armed: root.confirming-delete;
                            clicked => {
                                if !root.confirming-delete {
                                    root.confirming-delete = true;
                                } else if root.on-ssh-form {
                                    root.delete();
                                } else {
                                    root.conn-delete();
                                }
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        if root.on-ssh-form || root.on-conn-form: ModalButton {
                            text: @tr("Cancel");
                            clicked => {
                                root.editing = false;
                                root.editing-conn-profile = false;
                            }
                        }
                        if root.on-ssh-form: ModalButton { text: @tr("Save"); primary: true; clicked => { root.save(); } }
                        if root.on-conn-form: ModalButton { text: @tr("Save"); primary: true; clicked => { root.conn-save(); } }
                        if !root.on-ssh-form && !root.on-conn-form: ModalButton { text: @tr("Close"); clicked => { root.close(); } }
                    }
                }
            }
        }
    }
}
