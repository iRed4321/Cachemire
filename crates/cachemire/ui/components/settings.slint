import { Theme } from "theme.slint";
import { LanguageSetting, SettingsCategory, ProfileTint, SshProfileRowData, SshProfileForm, ConnProfileForm } from "types.slint";
import { VScrollBar, ModalButton, CheckRow, SegmentedToggle } from "widgets.slint";
import { IconPlus, IconPencil, IconSettings, IconKey, IconPalette, IconFlask, IconInfo } from "icons.slint";
import { ConnectionModalField, ConnProfileRowData, TintDot } from "connection-picker.slint";
import { Preferences, About } from "../globals.slint";
export { SshProfileRowData, SshProfileForm, ConnProfileForm }

// one choice of a row of exclusive options (the language)
component SegmentButton inherits Rectangle {
    in property <string> text;
    in property <bool> selected: false;
    callback clicked <=> area.clicked;

    width: label.preferred-width + Theme.px(28px);
    height: Theme.px(28px);
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: selected ? Theme.accent-blue : Theme.border-soft;
    background: selected ? Theme.accent-blue.with-alpha(0.18) : (area.has-hover ? Theme.bg-hover : transparent);

    area := TouchArea { mouse-cursor: pointer; }
    label := Text {
        text: root.text;
        color: selected ? Theme.accent-blue : Theme.text-secondary;
        font-weight: selected ? 600 : 400;
        font-size: Theme.pt(12px);
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
    }
}

component ProfileRow inherits Rectangle {
    in property <string> name;
    in property <string> username;
    in property <bool> active;
    // set by the list to its own width, like ConnectionRow's `row-width`
    in property <length> row-width;
    callback activate();
    callback edit();

    width: row-width;
    height: Theme.px(46px);
    // opaque at rest (the list box's color): a hover change only redraws the row, which then covers its own area
    background: row-area.has-hover ? Theme.bg-hover-elevated : Theme.bg-sunken;

    row-area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.activate(); }

        HorizontalLayout {
            padding-left: Theme.px(12px);
            padding-right: Theme.px(8px);
            spacing: Theme.px(10px);
            cross-axis-alignment: center;

            // radio: the profile the SSH connections without a login use
            Rectangle {
                width: Theme.px(16px);
                height: Theme.px(16px);
                border-radius: self.width / 2;
                border-width: 1.5px;
                border-color: root.active ? Theme.accent-blue : Theme.text-tertiary;
                if root.active: Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: Theme.px(8px);
                    height: Theme.px(8px);
                    border-radius: self.width / 2;
                    background: Theme.accent-blue;
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: Theme.px(1px);
                Text {
                    text: root.name;
                    font-size: Theme.pt(12px);
                    font-weight: 600;
                    color: Theme.text-primary;
                    overflow: elide;
                }
                Text {
                    text: root.username;
                    font-size: Theme.pt(11px);
                    font-family: Theme.font-mono;
                    color: Theme.text-tertiary;
                    overflow: elide;
                }
            }
            if root.active: Rectangle {
                width: active-label.preferred-width + Theme.px(14px);
                height: Theme.px(18px);
                border-radius: self.height / 2;
                background: Theme.accent-blue.with-alpha(0.18);
                active-label := Text {
                    text: @tr("Active");
                    font-size: Theme.pt(10.5px);
                    font-weight: 600;
                    color: Theme.accent-blue;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: 100%;
                    height: 100%;
                }
            }
            edit-area := Rectangle {
                width: Theme.px(24px);
                height: Theme.px(24px);
                border-radius: Theme.radius-sm;
                background: edit-touch.has-hover ? Theme.bg-hover : transparent;
                IconPencil {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    size: Theme.icon-sm;
                    tint: Theme.text-tertiary;
                }
                edit-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.edit(); }
                }
            }
        }
    }
}

// "+ Add ..." at the right of a section's title
component AddLink inherits Rectangle {
    in property <string> text;
    callback clicked <=> add-area.clicked;

    width: add-row.preferred-width + Theme.px(20px);
    height: Theme.px(24px);
    border-radius: Theme.radius-sm;
    background: add-area.has-hover ? Theme.bg-hover : transparent;
    add-area := TouchArea { mouse-cursor: pointer; }
    add-row := HorizontalLayout {
        x: Theme.px(10px);
        width: parent.width - Theme.px(20px);
        spacing: Theme.px(6px);
        cross-axis-alignment: center;
        IconPlus { size: Theme.icon-sm; tint: Theme.accent-blue; }
        Text {
            text: root.text;
            color: Theme.accent-blue;
            font-size: Theme.pt(12px);
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}

// one connection profile in the settings list: click to edit it
component ConnProfileRow inherits Rectangle {
    in property <string> name;
    in property <ProfileTint> tint;
    in property <length> row-width;
    callback edit();

    width: row-width;
    height: Theme.px(34px);
    // opaque at rest (the list box's color), like ProfileRow
    background: row-area.has-hover ? Theme.bg-hover-elevated : Theme.bg-sunken;

    row-area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.edit(); }

        HorizontalLayout {
            padding-left: Theme.px(12px);
            padding-right: Theme.px(8px);
            spacing: Theme.px(10px);
            cross-axis-alignment: center;
            TintDot { tint: root.tint; size: Theme.px(14px); }
            Text {
                text: root.name;
                font-size: Theme.pt(12px);
                font-weight: 600;
                color: Theme.text-primary;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            IconPencil { size: Theme.icon-sm; tint: Theme.text-tertiary; }
        }
    }
}

// the eight tints to choose from, the chosen one ringed
component TintSwatches inherits HorizontalLayout {
    in-out property <ProfileTint> tint: ProfileTint.red;
    property <[ProfileTint]> tints: [
        ProfileTint.red, ProfileTint.orange, ProfileTint.yellow, ProfileTint.green,
        ProfileTint.cyan, ProfileTint.blue, ProfileTint.purple, ProfileTint.pink,
    ];

    alignment: start;
    spacing: Theme.px(8px);
    for t in root.tints: Rectangle {
        width: Theme.px(26px);
        height: Theme.px(26px);
        border-radius: self.width / 2;
        border-width: 2px;
        border-color: root.tint == t ? Theme.text-primary : (swatch-area.has-hover ? Theme.text-tertiary : transparent);
        TintDot {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            tint: t;
            size: Theme.px(16px);
        }
        swatch-area := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.tint = t; }
        }
    }
}


// one category in the left column of the settings window, its icon picked by `category`
component CategoryItem inherits Rectangle {
    in property <SettingsCategory> category;
    in property <string> text;
    in property <bool> selected: false;
    callback clicked <=> area.clicked;
    property <color> icon-tint: selected ? Theme.accent-blue : Theme.text-tertiary;

    height: Theme.px(32px);
    border-radius: Theme.radius-md;
    background: selected ? Theme.bg-selected-soft : (area.has-hover ? Theme.bg-hover : transparent);

    area := TouchArea { mouse-cursor: pointer; }
    HorizontalLayout {
        padding-left: Theme.px(10px);
        padding-right: Theme.px(10px);
        spacing: Theme.px(10px);
        cross-axis-alignment: center;
        Rectangle {
            width: Theme.icon-md;
            height: Theme.icon-md;
            if root.category == SettingsCategory.defaults: IconSettings { size: Theme.icon-md; tint: root.icon-tint; }
            if root.category == SettingsCategory.ssh-profiles: IconKey { size: Theme.icon-md; tint: root.icon-tint; }
            if root.category == SettingsCategory.conn-profiles: IconPalette { size: Theme.icon-md; tint: root.icon-tint; }
            if root.category == SettingsCategory.experimental: IconFlask { size: Theme.icon-md; tint: root.icon-tint; }
            if root.category == SettingsCategory.about: IconInfo { size: Theme.icon-md; tint: root.icon-tint; }
        }
        Text {
            text: root.text;
            font-size: Theme.pt(12px);
            font-weight: root.selected ? 600 : 400;
            color: root.selected ? Theme.text-primary : Theme.text-secondary;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
    }
}

// a setting's name, in bold above its control
component SettingTitle inherits Text {
    font-size: Theme.pt(12px);
    font-weight: 600;
    color: Theme.text-primary;
}

// the gray explanation under a setting; wrapped text needs its height set (2 lines by default)
component SettingHint inherits Text {
    height: Theme.pt(28px);
    font-size: Theme.pt(10.5px);
    color: Theme.text-tertiary;
    wrap: word-wrap;
}

// a page of settings that scrolls once it's taller than the window leaves it
component SettingsPage inherits HorizontalLayout {
    vertical-stretch: 1;
    page-flick := Flickable {
        horizontal-stretch: 1;
        interactive: true;
        VerticalLayout {
            // a Flickable's content isn't sized by its frame; the margin keeps text off the bar
            width: page-flick.width - Theme.px(12px);
            alignment: start;
            spacing: Theme.px(20px);
            @children
        }
    }
    VScrollBar {
        content-height: page-flick.content-height;
        content-y <=> page-flick.content-y;
    }
}

// The settings window: its categories on the left, the settings of the one picked on the
// right, where the add/edit form of an SSH or connection profile replaces the list.
// Passwords are never shown; blank keeps the stored one.
export component SettingsModal inherits Rectangle {
    in property <[SshProfileRowData]> profiles: Preferences.ssh-profiles;
    // whether the clipboard holds text, for each field's right-click "Paste"
    callback clipboard-has-text() -> bool;
    in property <[ConnProfileRowData]> conn-profiles: Preferences.conn-profiles;
    in property <string> error: Preferences.error;
    in-out property <SettingsCategory> category <=> Preferences.category;
    // the interface language
    in property <LanguageSetting> language: Preferences.language;
    callback language-selected(setting: LanguageSetting);
    language-selected(setting) => { Preferences.language-selected(setting); }
    // whether the export buttons start on escaped JSON rather than plain JSON
    in property <bool> export-escaped: Preferences.export-escaped;
    callback export-escaped-selected(escaped: bool);
    export-escaped-selected(escaped) => { Preferences.export-escaped-selected(escaped); }
    // how many entries of a key the global search reads
    in property <int> search-depth: Preferences.search-depth;
    callback search-depth-selected(depth: int);
    search-depth-selected(depth) => { Preferences.search-depth-selected(depth); }
    // experimental: the global search lets Redis filter with a script
    in property <bool> server-search: Preferences.server-search;
    callback server-search-toggled(enabled: bool);
    server-search-toggled(enabled) => { Preferences.server-search-toggled(enabled); }
    // looks for an update each time the app starts
    in property <bool> check-updates-at-startup: Preferences.check-updates-at-startup;
    callback check-updates-at-startup-toggled(enabled: bool);
    check-updates-at-startup-toggled(enabled) => { Preferences.check-updates-at-startup-toggled(enabled); }
    // reopens the last connection with its tabs and open folders at startup
    in property <bool> restore-session: Preferences.restore-session;
    callback restore-session-toggled(enabled: bool);
    restore-session-toggled(enabled) => { Preferences.restore-session-toggled(enabled); }
    // the SSH profile form is showing instead of the list
    in-out property <bool> editing <=> Preferences.ssh-profile-editing;
    in-out property <string> field-id <=> Preferences.ssh-profile-id;
    in-out property <string> field-name <=> Preferences.ssh-profile-name;
    in-out property <string> field-username <=> Preferences.ssh-profile-username;
    in-out property <string> field-password <=> Preferences.ssh-profile-password;
    callback activate(id: string);
    activate(id) => { Preferences.ssh-profile-activated(id); }
    callback save();
    save => { Preferences.ssh-profile-saved({ id: field-id, name: field-name, username: field-username, password: field-password }); }
    callback delete();
    delete => { Preferences.ssh-profile-deleted(field-id); }
    callback close();
    close => { Preferences.open = false; }
    // the connection profile form is showing instead of the list
    in-out property <bool> editing-conn-profile <=> Preferences.conn-profile-editing;
    in-out property <string> conn-field-id <=> Preferences.conn-profile-id;
    in-out property <string> conn-field-name <=> Preferences.conn-profile-name;
    in-out property <ProfileTint> conn-field-tint <=> Preferences.conn-profile-tint;
    callback conn-save();
    conn-save => { Preferences.conn-profile-saved({ id: conn-field-id, name: conn-field-name, tint: conn-field-tint }); }
    callback conn-delete();
    conn-delete => { Preferences.conn-profile-deleted(conn-field-id); }

    property <bool> confirming-delete: false;
    property <bool> on-ssh-form: root.category == SettingsCategory.ssh-profiles && root.editing;
    property <bool> on-conn-form: root.category == SettingsCategory.conn-profiles && root.editing-conn-profile;
    property <length> row-height: Theme.px(46px);
    property <length> conn-row-height: Theme.px(34px);

    function select(category: SettingsCategory) {
        root.editing = false;
        root.editing-conn-profile = false;
        root.confirming-delete = false;
        Preferences.error = "";
        root.category = category;
    }

    function show-form(id: string, name: string, username: string) {
        root.field-id = id;
        root.field-name = name;
        root.field-username = username;
        root.field-password = "";
        root.confirming-delete = false;
        root.editing = true;
    }

    function show-conn-form(id: string, name: string, tint: ProfileTint) {
        root.conn-field-id = id;
        root.conn-field-name = name;
        root.conn-field-tint = tint;
        root.confirming-delete = false;
        root.editing-conn-profile = true;
    }

    background: #000000aa;

    TouchArea {
        clicked => { root.close(); }
    }

    // centered by a layout, for the reason given in ConnectionModal
    VerticalLayout {
        alignment: center;
        cross-axis-alignment: center;

        card := Rectangle {
            width: min(Theme.px(780px), root.width - Theme.px(32px));
            height: min(Theme.px(540px), root.height - Theme.px(48px));
            background: Theme.bg-elevated;
            border-radius: Theme.radius-lg;
            border-width: 1px;
            border-color: Theme.border-soft;
            drop-shadow-color: Theme.shadow-color;
            drop-shadow-blur: Theme.shadow-blur;
            drop-shadow-offset-y: Theme.shadow-offset-y;

            // swallow clicks so they don't bubble to the backdrop's close
            TouchArea { }

            // inset by the border, so the column's background leaves it visible
            HorizontalLayout {
                padding: 1px;

                // ---- the categories
                Rectangle {
                    width: Theme.px(200px);
                    background: Theme.bg-panel;
                    border-top-left-radius: Theme.radius-lg - 1px;
                    border-bottom-left-radius: Theme.radius-lg - 1px;

                    VerticalLayout {
                        padding: Theme.px(12px);
                        padding-top: Theme.px(16px);
                        spacing: Theme.px(2px);

                        HorizontalLayout {
                            padding-left: Theme.px(10px);
                            padding-bottom: Theme.px(10px);
                            Text {
                                text: @tr("Settings");
                                height: Theme.pt(18px);
                                font-size: Theme.pt(14px);
                                font-weight: 700;
                                color: Theme.text-primary;
                                vertical-alignment: center;
                            }
                        }
                        CategoryItem {
                            category: SettingsCategory.defaults;
                            text: @tr("Default behaviors");
                            selected: root.category == self.category;
                            clicked => { root.select(self.category); }
                        }
                        CategoryItem {
                            category: SettingsCategory.ssh-profiles;
                            text: @tr("SSH profiles");
                            selected: root.category == self.category;
                            clicked => { root.select(self.category); }
                        }
                        CategoryItem {
                            category: SettingsCategory.conn-profiles;
                            text: @tr("Connection profiles");
                            selected: root.category == self.category;
                            clicked => { root.select(self.category); }
                        }
                        CategoryItem {
                            category: SettingsCategory.experimental;
                            text: @tr("Experimental");
                            selected: root.category == self.category;
                            clicked => { root.select(self.category); }
                        }
                        // About sits apart, at the bottom of the column
                        Rectangle { vertical-stretch: 1; }
                        CategoryItem {
                            category: SettingsCategory.about;
                            text: @tr("About");
                            selected: root.category == self.category;
                            clicked => { root.select(self.category); }
                        }
                    }
                }
                Rectangle { width: 1px; background: Theme.border-soft; }

                // ---- the page of the category picked
                VerticalLayout {
                    horizontal-stretch: 1;
                    padding: Theme.px(20px);
                    padding-top: Theme.px(16px);
                    padding-bottom: Theme.px(16px);
                    spacing: Theme.px(12px);

                    HorizontalLayout {
                        height: Theme.px(24px);
                        Text {
                            text: root.on-conn-form ? (root.conn-field-id == "" ? @tr("New connection profile") : @tr("Edit connection profile"))
                                : root.on-ssh-form ? (root.field-id == "" ? @tr("New SSH profile") : @tr("Edit SSH profile"))
                                : root.category == SettingsCategory.ssh-profiles ? @tr("SSH profiles")
                                : root.category == SettingsCategory.conn-profiles ? @tr("Connection profiles")
                                : root.category == SettingsCategory.experimental ? @tr("Experimental")
                                : root.category == SettingsCategory.about ? @tr("About")
                                : @tr("Default behaviors");
                            font-size: Theme.pt(14px);
                            font-weight: 700;
                            color: Theme.text-primary;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                        if root.category == SettingsCategory.ssh-profiles && !root.on-ssh-form: AddLink {
                            text: @tr("Add profile");
                            clicked => { root.show-form("", "", ""); }
                        }
                        if root.category == SettingsCategory.conn-profiles && !root.on-conn-form: AddLink {
                            text: @tr("Add profile");
                            clicked => { root.show-conn-form("", "", ProfileTint.red); }
                        }
                    }

                    // ---- default behaviors
                    if root.category == SettingsCategory.defaults: SettingsPage {
                        VerticalLayout {
                            spacing: Theme.px(6px);
                            SettingTitle { text: @tr("Language"); }
                            // each language is named in itself, so it can be found from
                            // any other one
                            HorizontalLayout {
                                alignment: start;
                                spacing: Theme.px(6px);
                                SegmentButton { text: @tr("Automatic"); selected: root.language == LanguageSetting.automatic; clicked => { root.language-selected(LanguageSetting.automatic); } }
                                SegmentButton { text: "English"; selected: root.language == LanguageSetting.english; clicked => { root.language-selected(LanguageSetting.english); } }
                                SegmentButton { text: "Français"; selected: root.language == LanguageSetting.french; clicked => { root.language-selected(LanguageSetting.french); } }
                            }
                        }

                        VerticalLayout {
                            spacing: Theme.px(6px);
                            SettingTitle { text: @tr("Export format"); }
                            // what the export buttons start on (they can be switched there)
                            HorizontalLayout {
                                alignment: start;
                                spacing: Theme.px(6px);
                                SegmentButton { text: @tr("JSON"); selected: !root.export-escaped; clicked => { root.export-escaped-selected(false); } }
                                SegmentButton { text: @tr("Escaped JSON"); selected: root.export-escaped; clicked => { root.export-escaped-selected(true); } }
                            }
                        }

                        VerticalLayout {
                            spacing: Theme.px(6px);
                            SettingTitle { text: @tr("Search depth"); }
                            HorizontalLayout {
                                alignment: start;
                                spacing: Theme.px(6px);
                                SegmentButton { text: "60"; selected: root.search-depth == 60; clicked => { root.search-depth-selected(60); } }
                                SegmentButton { text: "200"; selected: root.search-depth == 200; clicked => { root.search-depth-selected(200); } }
                                SegmentButton { text: "1000"; selected: root.search-depth == 1000; clicked => { root.search-depth-selected(1000); } }
                            }
                            SettingHint {
                                text: @tr("How many entries of each key (hash fields, list items, set members...) the global search reads. Fewer is faster, but a match deeper inside a big key is missed.");
                            }
                        }

                        VerticalLayout {
                            spacing: Theme.px(4px);
                            SettingTitle { text: @tr("Startup"); }
                            CheckRow {
                                text: @tr("Restore the last connection");
                                checked: root.restore-session;
                                toggled => { root.restore-session-toggled(!root.restore-session); }
                            }
                            SettingHint {
                                text: @tr("Cachemire reconnects to the connection it was closed on, with its tabs and open folders. An AWS connection signs in again first, in the browser if its session has expired.");
                            }
                            CheckRow {
                                text: @tr("Check for Updates at startup");
                                checked: root.check-updates-at-startup;
                                toggled => { root.check-updates-at-startup-toggled(!root.check-updates-at-startup); }
                            }
                            SettingHint {
                                text: @tr("Each time Cachemire starts, it looks for a newer version on the channel picked in About (the i button of the title bar), and opens it when there is one.");
                            }
                        }
                    }

                    // ---- experimental
                    if root.category == SettingsCategory.experimental: SettingsPage {
                        VerticalLayout {
                            spacing: Theme.px(4px);
                            CheckRow {
                                text: @tr("Search on the server (Lua script)");
                                checked: root.server-search;
                                toggled => { root.server-search-toggled(!root.server-search); }
                            }
                            SettingHint {
                                text: @tr("The global search lets Redis filter the data itself, so far less of it travels. It uses the server's CPU while it runs, needs permission to run scripts, and goes back to the normal search if the server refuses.");
                                height: Theme.pt(42px);
                            }
                        }
                    }

                    // ---- about: the version, the repository and the updates
                    if root.category == SettingsCategory.about: SettingsPage {
                        HorizontalLayout {
                            spacing: Theme.px(14px);
                            alignment: start;
                            Image {
                                source: @image-url("../../../../resources/icon.png");
                                width: Theme.px(48px);
                                height: Theme.px(48px);
                            }
                            VerticalLayout {
                                alignment: center;
                                spacing: Theme.px(2px);
                                Text {
                                    text: "Cachemire by Léo Parent";
                                    font-size: Theme.pt(14px);
                                    font-weight: 700;
                                    color: Theme.text-primary;
                                }
                                Text {
                                    text: About.version;
                                    font-size: Theme.pt(12.5px);
                                    color: Theme.text-secondary;
                                }
                                HorizontalLayout {
                                    alignment: start;
                                    Text {
                                        text: @tr("GitHub repository");
                                        font-size: Theme.pt(12px);
                                        color: Theme.accent-blue;
                                        TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { About.open-repo(); }
                                        }
                                    }
                                }
                            }
                        }

                        VerticalLayout {
                            spacing: Theme.px(8px);
                            SettingTitle { text: @tr("Updates"); }
                            HorizontalLayout {
                                alignment: start;
                                SegmentedToggle {
                                    options: [@tr("Stable"), @tr("Beta")];
                                    segment-width: Theme.px(64px);
                                    current: About.channel;
                                    picked(index) => { if (!About.busy && index != About.channel) { About.channel-picked(index); } }
                                }
                            }
                            HorizontalLayout {
                                alignment: start;
                                spacing: Theme.px(8px);
                                ModalButton {
                                    text: About.busy ? @tr("Checking...") : @tr("Check for updates");
                                    clicked => { if (!About.busy) { About.check(); } }
                                }
                                if About.update-available: ModalButton {
                                    text: About.download-label;
                                    primary: true;
                                    clicked => { if (!About.busy) { About.download(); } }
                                }
                            }
                            if About.status != "": Text {
                                // a layout can't tell how far wrapped text grows: about 60 characters a line
                                height: Theme.pt(16px) * max(1, ceil(self.text.character-count / 60));
                                text: About.status;
                                font-size: Theme.pt(12px);
                                color: Theme.text-secondary;
                                wrap: word-wrap;
                            }
                        }
                    }

                    // ---- the SSH profiles: grows with its rows, and scrolls once the page is full
                    if root.category == SettingsCategory.ssh-profiles && !root.editing: VerticalLayout {
                        vertical-stretch: 1;
                        spacing: Theme.px(12px);
                        SettingHint {
                            text: @tr("The active profile logs in to the SSH tunnels that have no username of their own. A connection that fills in its own username and password uses those instead.");
                        }
                        list-box := Rectangle {
                            property <length> full-height: (root.profiles.length == 0 ? Theme.px(64px) : root.profiles.length * root.row-height) + Theme.px(2px);
                            min-height: min(self.full-height, root.row-height + Theme.px(2px));
                            preferred-height: self.full-height;
                            max-height: self.full-height;
                            vertical-stretch: 1;
                            background: Theme.bg-sunken;
                            border-radius: Theme.radius-md;
                            border-width: 1px;
                            border-color: Theme.border-soft;

                            if root.profiles.length == 0: Text {
                                text: @tr("No SSH profiles yet");
                                font-size: Theme.pt(12px);
                                color: Theme.text-tertiary;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            if root.profiles.length > 0: HorizontalLayout {
                                padding: Theme.px(1px);
                                list-flick := Flickable {
                                    horizontal-stretch: 1;
                                    interactive: true;
                                    list-content := VerticalLayout {
                                        // pinned to the box's width (less its border):
                                        // a Flickable's content isn't sized by its frame
                                        width: list-box.width - Theme.px(2px);
                                        alignment: start;
                                        for p in root.profiles: ProfileRow {
                                            row-width: list-content.width;
                                            name: p.name;
                                            username: p.username;
                                            active: p.active;
                                            activate => { root.activate(p.id); }
                                            edit => { root.show-form(p.id, p.name, p.username); }
                                        }
                                    }
                                }
                                VScrollBar {
                                    content-height: list-flick.content-height;
                                    content-y <=> list-flick.content-y;
                                }
                            }
                        }
                        Rectangle { vertical-stretch: 1; }
                    }

                    // ---- the connection profiles, laid out like the SSH ones
                    if root.category == SettingsCategory.conn-profiles && !root.editing-conn-profile: VerticalLayout {
                        vertical-stretch: 1;
                        spacing: Theme.px(12px);
                        SettingHint {
                            text: @tr("A connection that has one of these profiles tints the app's background while you are connected to it, to tell environments apart.");
                        }
                        conn-list-box := Rectangle {
                            property <length> full-height: (root.conn-profiles.length == 0 ? Theme.px(52px) : root.conn-profiles.length * root.conn-row-height) + Theme.px(2px);
                            min-height: min(self.full-height, root.conn-row-height + Theme.px(2px));
                            preferred-height: self.full-height;
                            max-height: self.full-height;
                            vertical-stretch: 1;
                            background: Theme.bg-sunken;
                            border-radius: Theme.radius-md;
                            border-width: 1px;
                            border-color: Theme.border-soft;

                            if root.conn-profiles.length == 0: Text {
                                text: @tr("No connection profiles yet");
                                font-size: Theme.pt(12px);
                                color: Theme.text-tertiary;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            if root.conn-profiles.length > 0: HorizontalLayout {
                                padding: Theme.px(1px);
                                conn-flick := Flickable {
                                    horizontal-stretch: 1;
                                    interactive: true;
                                    conn-content := VerticalLayout {
                                        width: conn-list-box.width - Theme.px(2px);
                                        alignment: start;
                                        for p in root.conn-profiles: ConnProfileRow {
                                            row-width: conn-content.width;
                                            name: p.name;
                                            tint: p.tint;
                                            edit => { root.show-conn-form(p.id, p.name, p.tint); }
                                        }
                                    }
                                }
                                VScrollBar {
                                    content-height: conn-flick.content-height;
                                    content-y <=> conn-flick.content-y;
                                }
                            }
                        }
                        Rectangle { vertical-stretch: 1; }
                    }

                    // ---- the form of one SSH profile
                    if root.on-ssh-form: VerticalLayout {
                        vertical-stretch: 1;
                        alignment: start;
                        spacing: Theme.px(10px);
                        ConnectionModalField {
                            clipboard-has-text() => { return root.clipboard-has-text(); } label: @tr("Name"); placeholder: @tr("Work bastion"); text <=> root.field-name; }
                        ConnectionModalField {
                            clipboard-has-text() => { return root.clipboard-has-text(); } label: @tr("SSH username"); text <=> root.field-username; }
                        ConnectionModalField {
                            clipboard-has-text() => { return root.clipboard-has-text(); }
                            label: @tr("SSH password");
                            placeholder: root.field-id == "" ? "" : @tr("Leave blank to keep current");
                            text <=> root.field-password;
                            is-password: true;
                        }
                    }

                    // ---- the form of one connection profile
                    if root.on-conn-form: VerticalLayout {
                        vertical-stretch: 1;
                        alignment: start;
                        spacing: Theme.px(10px);
                        ConnectionModalField {
                            clipboard-has-text() => { return root.clipboard-has-text(); } label: @tr("Name"); placeholder: "Production"; text <=> root.conn-field-name; }
                        VerticalLayout {
                            spacing: Theme.px(6px);
                            Text {
                                text: @tr("Color");
                                font-size: Theme.pt(10.5px);
                                font-weight: 600;
                                color: Theme.text-secondary;
                            }
                            TintSwatches { tint <=> root.conn-field-tint; }
                        }
                    }

                    if error != "": Text {
                        text: error;
                        height: Theme.pt(28px);
                        color: Theme.accent-red;
                        font-size: Theme.pt(11px);
                        wrap: word-wrap;
                    }

                    // ---- the buttons: a form's, or Close
                    HorizontalLayout {
                        height: Theme.px(28px);
                        spacing: Theme.px(8px);
                        // removing is one click to arm, a second to do it
                        if (root.on-ssh-form && root.field-id != "") || (root.on-conn-form && root.conn-field-id != ""): ModalButton {
                            text: root.confirming-delete ? @tr("Click again to delete") : @tr("Delete");
                            danger: true;
                            armed: root.confirming-delete;
                            clicked => {
                                if !root.confirming-delete {
                                    root.confirming-delete = true;
                                } else if root.on-ssh-form {
                                    root.delete();
                                } else {
                                    root.conn-delete();
                                }
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        if root.on-ssh-form || root.on-conn-form: ModalButton {
                            text: @tr("Cancel");
                            clicked => {
                                root.editing = false;
                                root.editing-conn-profile = false;
                            }
                        }
                        if root.on-ssh-form: ModalButton { text: @tr("Save"); primary: true; clicked => { root.save(); } }
                        if root.on-conn-form: ModalButton { text: @tr("Save"); primary: true; clicked => { root.conn-save(); } }
                        if !root.on-ssh-form && !root.on-conn-form: ModalButton { text: @tr("Close"); clicked => { root.close(); } }
                    }
                }
            }
        }
    }
}
