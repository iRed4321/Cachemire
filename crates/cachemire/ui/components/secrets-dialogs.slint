import { Theme } from "theme.slint";
import { ModalButton } from "widgets.slint";
import { ConnectionModalField } from "connection-picker.slint";

// Asked when the system keyring can't take a password being saved. Rust opens it
// and answers the three callbacks (see src/keyring_dialogs.rs).
export global KeyringDialog {
    in-out property <bool> open: false;
    // whether saving without the password is offered (a connection can ask for it later)
    in property <bool> can-leave-out: true;
    callback save-in-file();
    callback save-without();
    callback cancelled();
}

// Asked when connecting to a connection saved without some of its passwords.
export global SecretsPrompt {
    in-out property <bool> open: false;
    in property <string> name;
    in property <bool> ask-password: false;
    in property <bool> ask-ssh-password: false;
    in property <bool> ask-ssh-passphrase: false;
    in-out property <string> password;
    in-out property <string> ssh-password;
    in-out property <string> ssh-passphrase;
    callback connect();
    callback cancelled();
}

// Over the whole window; only its buttons (or Escape) close it.
export component DialogBackdrop inherits Rectangle {
    callback escaped();
    in property <length> card-width: Theme.px(480px);
    background: #000000aa;
    TouchArea { }

    card := Rectangle {
        width: min(parent.width - Theme.px(80px), root.card-width);
        height: content.preferred-height;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Theme.bg-elevated;
        border-radius: Theme.radius-lg;
        border-width: 1px;
        border-color: Theme.border-soft;
        drop-shadow-color: Theme.shadow-color;
        drop-shadow-blur: Theme.shadow-blur;
        drop-shadow-offset-y: Theme.shadow-offset-y;
        TouchArea { }

        FocusScope {
            focus-on-click: false;
            key-pressed(event) => {
                if event.text == Key.Escape {
                    root.escaped();
                    return accept;
                }
                return reject;
            }
            content := VerticalLayout {
                padding: Theme.px(18px);
                spacing: Theme.px(12px);
                @children
            }
        }
    }
}

export component KeyringModal inherits DialogBackdrop {
    escaped => { KeyringDialog.open = false; KeyringDialog.cancelled(); }

    Text {
        text: @tr("System keyring unavailable");
        font-size: Theme.pt(14px);
        font-weight: 700;
        color: Theme.text-primary;
    }
    Text {
        text: @tr("The system keyring is unavailable, so the password can't be stored safely.");
        font-size: Theme.pt(12px);
        color: Theme.text-secondary;
        wrap: word-wrap;
    }
    Text {
        text: KeyringDialog.can-leave-out
            ? @tr("Save it in the data file as plain text, or save without it and be asked for it each time you connect.")
            : @tr("Save it in the data file as plain text, or cancel.");
        font-size: Theme.pt(10.5px);
        color: Theme.text-tertiary;
        wrap: word-wrap;
    }
    HorizontalLayout {
        spacing: Theme.px(8px);
        alignment: end;
        ModalButton {
            text: @tr("Cancel");
            clicked => { KeyringDialog.open = false; KeyringDialog.cancelled(); }
        }
        if KeyringDialog.can-leave-out: ModalButton {
            text: @tr("Save without the password");
            clicked => { KeyringDialog.open = false; KeyringDialog.save-without(); }
        }
        ModalButton {
            text: @tr("Save in the file anyway");
            primary: true;
            clicked => { KeyringDialog.open = false; KeyringDialog.save-in-file(); }
        }
    }
}

export component SecretsPromptModal inherits DialogBackdrop {
    callback clipboard-has-text() -> bool;
    escaped => { SecretsPrompt.open = false; SecretsPrompt.cancelled(); }

    function submit() {
        SecretsPrompt.open = false;
        SecretsPrompt.connect();
    }

    Text {
        text: @tr("Password needed");
        font-size: Theme.pt(14px);
        font-weight: 700;
        color: Theme.text-primary;
    }
    Text {
        text: SecretsPrompt.name;
        font-size: Theme.pt(12px);
        color: Theme.text-secondary;
        overflow: elide;
    }
    if SecretsPrompt.ask-password: ConnectionModalField {
        label: @tr("Password");
        text <=> SecretsPrompt.password;
        is-password: true;
        clipboard-has-text() => { return root.clipboard-has-text(); }
        accepted => { root.submit(); }
        init => { self.focus-all(); }
    }
    if SecretsPrompt.ask-ssh-password: ConnectionModalField {
        label: @tr("SSH password");
        text <=> SecretsPrompt.ssh-password;
        is-password: true;
        clipboard-has-text() => { return root.clipboard-has-text(); }
        accepted => { root.submit(); }
        init => { if !SecretsPrompt.ask-password { self.focus-all(); } }
    }
    if SecretsPrompt.ask-ssh-passphrase: ConnectionModalField {
        label: @tr("Key passphrase");
        text <=> SecretsPrompt.ssh-passphrase;
        is-password: true;
        clipboard-has-text() => { return root.clipboard-has-text(); }
        accepted => { root.submit(); }
        init => { if !SecretsPrompt.ask-password && !SecretsPrompt.ask-ssh-password { self.focus-all(); } }
    }
    Text {
        text: @tr("Kept in memory until Cachemire closes, never saved.");
        font-size: Theme.pt(10.5px);
        color: Theme.text-tertiary;
        wrap: word-wrap;
    }
    HorizontalLayout {
        spacing: Theme.px(8px);
        alignment: end;
        ModalButton {
            text: @tr("Cancel");
            clicked => { SecretsPrompt.open = false; SecretsPrompt.cancelled(); }
        }
        ModalButton {
            text: @tr("Connect");
            primary: true;
            clicked => { root.submit(); }
        }
    }
}
