import { Theme } from "theme.slint";
import { ConnectionStatus, SettingsCategory, ProfileTint } from "types.slint";
import { IconCloud, IconDot, IconSpinner, IconChevron, IconMinimize, IconMaximize, IconClose, IconCopy, IconSettings, IconLock, IconUnlinked, IconMore, IconRefresh, IconPencil } from "icons.slint";
import { ConnectionState, AwsAccount, Preferences, ConnectionView } from "../globals.slint";
import { Hint } from "widgets.slint";

component WinControlButton inherits Rectangle {
    in property <bool> danger: false;
    // exposed so the glyph passed in as a child can react to the hover
    out property <bool> hovered: area.has-hover;
    callback clicked <=> area.clicked;
    width: Theme.px(44px);
    height: 100%;
    background: area.has-hover ? (danger ? Theme.accent-red : Theme.bg-hover) : transparent;

    HorizontalLayout {
        alignment: center;
        cross-axis-alignment: center;
        @children
    }

    area := TouchArea { }
}

// A press-and-drag handle: `drag-started` fires once the pointer moves a few pixels
// with the button held, never on a plain click or on the second click of a double
// click (the OS would take the move request for that double click and run no move).
component WindowDragArea inherits TouchArea {
    callback drag-started();

    property <length> press-x;
    property <length> press-y;
    property <bool> armed: false;
    // a click ended less than a double-click time ago, and no drag has run since
    property <bool> recent-click: false;
    property <bool> dragged: false;

    Timer {
        interval: 500ms;
        running: root.recent-click;
        triggered => { root.recent-click = false; }
    }

    pointer-event(event) => {
        if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
            armed = !recent-click;
            dragged = false;
            press-x = self.mouse-x;
            press-y = self.mouse-y;
        } else if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel {
            armed = false;
            recent-click = event.kind == PointerEventKind.up && !dragged;
        }
    }
    moved => {
        if armed && self.pressed
            && (abs(self.mouse-x - press-x) > Theme.px(4px) || abs(self.mouse-y - press-y) > Theme.px(4px)) {
            armed = false;
            dragged = true;
            drag-started();
        }
    }
}

// A small outlined label in the pill: the tunnel's lock and "SSH" or "K8s".
component SshBadge inherits Rectangle {
    in property <string> text: "SSH";
    height: Theme.px(18px);
    width: row.preferred-width;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: Theme.border-soft.mix(Theme.text-tertiary, 0.6);
    row := HorizontalLayout {
        padding-left: Theme.px(6px);
        padding-right: Theme.px(6px);
        spacing: Theme.px(4px);
        VerticalLayout {
            alignment: center;
            IconLock { size: Theme.px(10px); tint: Theme.text-secondary; }
        }
        Text {
            text: root.text;
            color: Theme.text-secondary;
            font-size: Theme.pt(10.5px);
            font-weight: 700;
            vertical-alignment: center;
        }
    }
}

// A square button beside the connection pill, in its shape.
component BarButton inherits Rectangle {
    in property <color> bar-background;
    in property <length> hairline: 1px;
    out property <bool> hovered: area.has-hover;
    callback clicked <=> area.clicked;
    border-radius: Theme.radius-md;
    background: bar-background;
    border-width: hairline;
    border-color: Theme.env-border;
    area := TouchArea { mouse-cursor: pointer; }
    @children
}

export component TitleBar inherits Rectangle {
    in property <bool> is-maximized: false;
    // the connection shown: the one in use, being connected to, or the one that failed
    in property <ConnectionView> view: ConnectionState.view;
    // whether the connection picker dropdown this bar controls is currently
    // open, purely to flip the chevron — the dropdown itself lives outside
    // TitleBar (see main.slint) so it can paint above the rest of the app
    in property <bool> expanded: false;
    // the cloud account (AWS): shown only when the machine has an .aws folder
    in property <bool> aws-available: AwsAccount.available;
    in property <bool> aws-connected: AwsAccount.connected;
    in property <bool> aws-busy: AwsAccount.busy;
    in property <string> aws-profile: AwsAccount.profile;
    // the pill while signed out: signs in
    callback aws-clicked();
    // the pill while signed in; `x` is where its dropdown should start
    callback aws-profile-clicked(x: length);
    callback bar-clicked();
    // the "Settings" button left of the pill
    callback settings-clicked();
    // the "more" button right of the pill: its menu opens under it
    callback more-clicked();
    callback drag-requested();
    callback maximize-toggle-requested();
    callback minimize-requested();
    callback close-requested();
    // the pointer rested on the pill: main.slint shows the connection's details under it
    out property <bool> details-shown: false;
    // where the "more" button ends, for its menu to end there too
    out property <length> more-right: more-button.x + more-button.width;

    background: Theme.bg-app;
    vertical-stretch: 0;
    // The display's scale (set by Rust). The bordered pills are snapped to whole device
    // pixels (see `snap`): on a fractional scale their 1px borders would otherwise
    // straddle two pixel rows and be partly missed by a partial repaint.
    in property <float> device-scale: 1.0;
    pure function snap(v: length) -> length {
        return round(v / 1px * root.device-scale) / root.device-scale * 1px;
    }
    property <length> hairline: snap(1px);
    height: snap(Theme.px(40px));

    // what the pill shows: a connection (named), being connected to, lost, or none
    property <bool> named: view.name != "";
    property <bool> connecting: view.connecting;
    property <bool> lost: !view.connecting && view.status == ConnectionStatus.disconnected;
    property <bool> has-ssh: view.ssh-via != "";

    // the details show once the pointer rests on the pill, never over the open list
    property <bool> pill-hovered: pill-area.has-hover;
    changed pill-hovered => {
        if !pill-hovered {
            details-shown = false;
        }
    }
    changed expanded => { details-shown = false; }
    Timer {
        interval: 500ms;
        running: root.pill-hovered && root.named && !root.expanded && !root.details-shown;
        triggered => { root.details-shown = true; }
    }

    // hover hint on the settings icon, which has no label; a click means the user knows
    // what it does, so no hint again until the pointer leaves and comes back
    property <bool> settings-hovered: settings-button.hovered;
    property <bool> settings-tooltip-shown: false;
    property <bool> settings-tooltip-suppressed: false;
    function hide-settings-tooltip() {
        if settings-tooltip-shown {
            settings-tooltip-shown = false;
            Hint.hide();
        }
    }
    changed settings-hovered => {
        if !settings-hovered {
            settings-tooltip-suppressed = false;
            hide-settings-tooltip();
        }
    }
    Timer {
        interval: 500ms;
        running: root.settings-hovered && !root.settings-tooltip-shown && !root.settings-tooltip-suppressed;
        triggered => {
            root.settings-tooltip-shown = true;
            Hint.show-below(@tr("Settings"), settings-button.absolute-position.x,
                settings-button.absolute-position.y + settings-button.height + Theme.px(6px));
        }
    }

    // draggable background: sits behind every interactive control below
    dragArea := WindowDragArea {
        drag-started => { drag-requested(); }
        double-clicked => { maximize-toggle-requested(); }
    }

    // the settings icon, just left of the connection pill, in the same pill shape
    settings-button := BarButton {
        x: snap(pill.x - self.width - Theme.px(6px));
        y: snap((parent.height - self.height) / 2);
        width: pill.height;
        height: pill.height;
        hairline: root.hairline;
        bar-background: root.bar-background(self.hovered);
        clicked => {
            root.settings-tooltip-suppressed = true;
            root.hide-settings-tooltip();
            root.settings-clicked();
        }
        IconSettings {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            size: Theme.icon-sm;
            tint: settings-button.hovered ? Theme.text-primary : Theme.text-secondary;
        }
    }

    // the cloud account at the far left, flat (a button look on hover only): "Sign in to AWS"
    // while signed out; signed in, the profile, whose list opens on a click
    if root.aws-available: aws-pill := Rectangle {
        x: snap(Theme.px(10px));
        y: pill.y;
        height: pill.height;
        width: snap(min(Theme.px(240px), main-row.preferred-width + Theme.px(22px)));
        border-radius: Theme.radius-md;
        background: main-area.has-hover ? Theme.bg-hover : transparent;
        main-area := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                if root.aws-connected {
                    root.aws-profile-clicked(aws-pill.absolute-position.x);
                } else {
                    root.aws-clicked();
                }
            }
        }
        main-row := HorizontalLayout {
            x: Theme.px(11px);
            width: parent.width - Theme.px(22px);
            spacing: Theme.px(7px);
            cross-axis-alignment: center;
            if root.aws-busy: IconSpinner { size: Theme.icon-sm; tint: Theme.accent-orange; }
            if !root.aws-busy: IconCloud {
                size: Theme.icon-sm;
                filled: root.aws-connected;
                tint: root.aws-connected ? Theme.accent-orange : Theme.text-secondary;
            }
            Text {
                text: !root.aws-connected ? @tr("Sign in to AWS") : (root.aws-profile == "" ? @tr("Select Profile") : root.aws-profile);
                color: root.aws-connected && root.aws-profile == "" ? Theme.text-secondary : Theme.text-primary;
                font-size: Theme.pt(12.5px);
                font-weight: 600;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
                min-width: 0px;
            }
            if root.aws-connected: IconChevron { size: Theme.icon-xs; down: true; tint: Theme.text-tertiary; }
        }
    }

    // below 960px of window, the pill is a third as wide and shows the connection's name alone
    property <bool> compact: root.width < 960px;

    // the background of the connection pill and the buttons beside it, never tinted: a profile's
    // color shows in their border only
    pure function bar-background(hovered: bool) -> color {
        return hovered ? Theme.bg-hover : Theme.bg-elevated;
    }

    // connection pill, centered — click opens the connection picker. A line along its bottom
    // takes the color of the connection's profile; what goes on (connecting, a connection
    // lost) is said in words where the address is, never in a color
    pill := Rectangle {
        x: snap((parent.width - self.width) / 2);
        y: snap((parent.height - self.height) / 2);
        width: snap(Theme.px(root.compact ? 180px : 420px));
        height: snap(Theme.px(30px));
        background: root.bar-background(pill-area.has-hover);
        border-radius: Theme.radius-md;
        border-width: hairline;
        // the profile's tint, even a light one
        border-color: Theme.env-border;
        clip: true;

        pill-area := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.bar-clicked(); }
        }

        HorizontalLayout {
            x: Theme.px(12px);
            y: 0;
            width: parent.width - Theme.px(root.lost && root.named && !root.compact ? 15px : 21px);
            height: parent.height;
            spacing: Theme.px(8px);
            cross-axis-alignment: center;
            // green once connected, grey otherwise (nothing picked, connecting, lost)
            IconDot {
                size: Theme.px(8px);
                tint: root.named && !root.connecting && !root.lost && root.view.status == ConnectionStatus.connected
                    ? Theme.accent-green.darker(0.15) : Theme.text-tertiary;
            }
            if root.named: Text {
                text: root.view.name;
                color: Theme.text-primary;
                font-size: Theme.pt(12.5px);
                font-weight: 600;
                vertical-alignment: center;
                horizontal-stretch: root.compact ? 1 : 0;
                overflow: elide;
            }
            if root.connecting: IconSpinner { size: Theme.px(12px); tint: Theme.text-primary; }
            if root.lost && root.named: IconUnlinked { size: Theme.px(13px); tint: Theme.text-primary; }
            if !root.compact || !root.named: Text {
                text: root.connecting
                    ? (root.has-ssh ? @tr("connecting through {}…", root.view.ssh-via) : @tr("connecting…"))
                    : root.lost ? root.view.status-detail
                    : root.named ? root.view.address
                    : @tr("No connection");
                color: root.lost && root.named ? Theme.text-primary : Theme.text-secondary;
                font-size: Theme.pt(12.5px);
                font-italic: root.connecting;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            if root.named && !root.connecting && !root.lost && root.has-ssh && !root.compact: SshBadge { text: root.view.kubernetes ? "K8s" : "SSH"; }
            if !(root.lost && root.named) || root.compact: IconChevron { size: Theme.icon-xs; down: !root.expanded; up: root.expanded; tint: Theme.text-tertiary; }
            // the one thing to do about a connection lost, right where it says so
            if root.lost && root.named && !root.compact: reconnect := Rectangle {
                width: reconnect-label.preferred-width + Theme.px(20px);
                height: Theme.px(22px);
                border-radius: Theme.radius-sm;
                border-width: 1px;
                border-color: Theme.text-tertiary;
                background: reconnect-area.has-hover ? Theme.bg-hover-elevated : transparent;
                reconnect-area := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { ConnectionState.reconnect-requested(); }
                }
                reconnect-label := Text {
                    text: @tr("Reconnect");
                    color: Theme.text-primary;
                    font-size: Theme.pt(11.5px);
                    font-weight: 700;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }
        }

        if root.named && root.view.has-profile: Rectangle {
            y: parent.height - self.height;
            height: snap(Theme.px(3px));
            background: Theme.profile-color(root.view.profile-tint);
        }
    }

    // the "more" button, just right of the connection pill: copy, reconnect, edit, disconnect
    more-button := BarButton {
        visible: root.named;
        x: snap(pill.x + pill.width + Theme.px(6px));
        y: snap((parent.height - self.height) / 2);
        width: pill.height;
        height: pill.height;
        hairline: root.hairline;
        bar-background: root.bar-background(self.hovered);
        clicked => { root.more-clicked(); }
        IconMore {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            size: Theme.icon-sm;
            tint: more-button.hovered ? Theme.text-primary : Theme.text-secondary;
        }
    }

    // window controls, pinned far right
    Rectangle {
        x: parent.width - self.width;
        width: 4 * Theme.px(44px);
        height: parent.height;

        HorizontalLayout {
            info-btn := WinControlButton {
                clicked => { Preferences.show(SettingsCategory.about); }
                Text {
                    text: "i";
                    font-size: Theme.pt(15px);
                    font-weight: 600;
                    color: info-btn.hovered ? Theme.text-primary : Theme.text-secondary;
                    vertical-alignment: center;
                }
            }
            WinControlButton {
                clicked => { minimize-requested(); }
                IconMinimize { size: Theme.icon-sm; }
            }
            WinControlButton {
                clicked => { maximize-toggle-requested(); }
                IconMaximize { restore: is-maximized; size: Theme.icon-sm; }
            }
            close-btn := WinControlButton {
                danger: true;
                clicked => { close-requested(); }
                // white on the red hover background, like the native caption button
                IconClose { size: Theme.icon-lg; tint: close-btn.hovered ? white : Theme.text-secondary; }
            }
        }
    }
}

// One line of the connection's details: a label, then its value.
component DetailLine inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    in property <bool> mono: false;
    spacing: Theme.px(10px);
    Text {
        width: Theme.px(76px);
        text: root.label;
        color: Theme.text-tertiary;
        font-size: Theme.pt(11.5px);
    }
    Text {
        horizontal-stretch: 1;
        text: root.value;
        color: Theme.text-primary;
        font-size: Theme.pt(root.mono ? 11px : 11.5px);
        font-family: root.mono ? Theme.font-mono : Theme.font-ui;
        wrap: word-wrap;
    }
}

// What the pill's connection is, shown under the pill while the pointer rests on it.
// Positioned (and shown) by main.slint.
export component ConnectionDetails inherits Rectangle {
    in property <ConnectionView> view: ConnectionState.view;
    in property <bool> read-only: ConnectionState.read-only;
    property <bool> lost: !view.connecting && view.status == ConnectionStatus.disconnected;

    width: Theme.px(320px);
    height: column.preferred-height;
    background: Theme.bg-elevated;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.border-soft;
    drop-shadow-color: Theme.shadow-color;
    drop-shadow-blur: Theme.shadow-blur;
    drop-shadow-offset-y: Theme.shadow-offset-y;

    column := VerticalLayout {
        padding-left: Theme.px(14px);
        padding-right: Theme.px(14px);
        padding-top: Theme.px(12px);
        padding-bottom: Theme.px(12px);
        spacing: Theme.px(7px);
        HorizontalLayout {
            spacing: Theme.px(8px);
            Text {
                text: root.view.name;
                color: Theme.text-primary;
                font-size: Theme.pt(13px);
                font-weight: 700;
                horizontal-stretch: 1;
                overflow: elide;
                vertical-alignment: center;
            }
            if root.view.has-profile: Rectangle {
                height: Theme.px(18px);
                width: min(badge.preferred-width, Theme.px(140px)) + Theme.px(14px);
                border-radius: Theme.radius-sm;
                background: Theme.profile-color(root.view.profile-tint);
                badge := Text {
                    x: Theme.px(7px);
                    width: parent.width - Theme.px(14px);
                    text: root.view.profile-name;
                    color: root.view.profile-tint == ProfileTint.yellow ? #1c1c1e : white;
                    font-size: Theme.pt(10.5px);
                    font-weight: 700;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
        if root.lost && root.view.status-detail != "": Text {
            text: root.view.status-detail;
            color: Theme.text-primary;
            font-size: Theme.pt(11.5px);
            wrap: word-wrap;
        }
        if root.view.server != "": DetailLine { label: @tr("Server"); value: root.view.server; }
        if root.view.address != "": DetailLine { label: @tr("Address"); value: root.view.address; mono: true; }
        if root.view.ssh-via != "": DetailLine { label: root.view.kubernetes ? @tr("Kubernetes") : @tr("SSH tunnel"); value: root.view.ssh-via; mono: true; }
        if root.view.connected && !root.lost: DetailLine {
            label: @tr("Access");
            value: root.read-only ? @tr("read-only") : @tr("read and write");
        }
    }
}

// One entry of the "more" menu: an icon, then what it does.
component MenuEntry inherits Rectangle {
    in property <string> text;
    callback clicked <=> area.clicked;
    height: Theme.px(28px);
    border-radius: Theme.radius-sm;
    // opaque at rest: a hover change only redraws the row, which then covers its own area
    background: area.has-hover ? Theme.bg-hover-elevated : Theme.bg-elevated;
    area := TouchArea { mouse-cursor: pointer; }
    HorizontalLayout {
        padding-left: Theme.px(8px);
        padding-right: Theme.px(12px);
        spacing: Theme.px(8px);
        alignment: start;
        VerticalLayout {
            alignment: center;
            @children
        }
        Text {
            text: root.text;
            color: Theme.text-primary;
            font-size: Theme.pt(12px);
            vertical-alignment: center;
        }
    }
}

// The "more" button's menu: what can be done with the pill's connection. Positioned and
// dismissed by main.slint, like the other menus.
export component ConnectionMenu inherits Rectangle {
    callback done();

    property <length> pad: Theme.px(4px);
    width: Theme.px(210px);
    height: entries.preferred-height;
    background: Theme.bg-elevated;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.border-soft;
    drop-shadow-color: Theme.shadow-color;
    drop-shadow-blur: Theme.shadow-blur;
    drop-shadow-offset-y: Theme.shadow-offset-y;

    // absorbs clicks on the padding so they don't reach the catcher behind
    TouchArea { }

    entries := VerticalLayout {
        padding: pad;
        MenuEntry {
            text: @tr("Copy connection string");
            clicked => { root.done(); ConnectionState.copy-connection-string(); }
            IconCopy { size: Theme.icon-sm; tint: Theme.text-secondary; }
        }
        MenuEntry {
            text: @tr("Reconnect");
            clicked => { root.done(); ConnectionState.reconnect-requested(); }
            IconRefresh { size: Theme.icon-sm; tint: Theme.text-secondary; }
        }
        MenuEntry {
            text: @tr("Edit connection…");
            clicked => { root.done(); ConnectionState.edit-requested(""); }
            IconPencil { size: Theme.icon-sm; tint: Theme.text-secondary; }
        }
        Rectangle {
            height: Theme.px(9px);
            Rectangle {
                height: 1px;
                background: Theme.border-soft;
            }
        }
        MenuEntry {
            text: @tr("Disconnect");
            clicked => { root.done(); ConnectionState.disconnect-requested(); }
            IconClose { size: Theme.icon-sm; tint: Theme.text-secondary; }
        }
    }
}
