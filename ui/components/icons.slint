export component IconMinimize inherits Rectangle {
    in property <color> tint: Theme.text-secondary;
    in property <length> size: 12px;
    width: size;
    height: size;
    Rectangle {
        y: parent.height * 0.5;
        width: parent.size * 0.82;
        height: 1.2px;
        background: tint;
    }
}

export component IconMaximize inherits Rectangle {
    in property <color> tint: Theme.text-secondary;
    in property <length> size: 12px;
    in property <bool> restore: false;
    width: size;
    height: size;

    // Modeled on Windows 11's Fluent caption glyphs: a rounded square for
    // maximize; for restore, a second square's top/right edges peek out
    // behind it — one open path, not a filled box, to read as an outline.
    if !restore: Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M6 3 H18 a3 3 0 0 1 3 3 V18 a3 3 0 0 1 -3 3 H6 a3 3 0 0 1 -3 -3 V6 a3 3 0 0 1 3 -3 z";
        fill: transparent;
        stroke: tint;
        stroke-width: 1.2px;
        stroke-line-join: round;
    }
    if restore: Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M6 7 H14 a3 3 0 0 1 3 3 V18 a3 3 0 0 1 -3 3 H6 a3 3 0 0 1 -3 -3 V10 a3 3 0 0 1 3 -3 z M7 7 V6 a3 3 0 0 1 3 -3 H18 a3 3 0 0 1 3 3 V14 a3 3 0 0 1 -3 3 H17";
        fill: transparent;
        stroke: tint;
        stroke-width: 1.2px;
        stroke-line-cap: round;
        stroke-line-join: round;
    }
}

// The cross only spans the middle ~40% of the box so it reads at the same
// visual weight as the "×" glyph it replaces at the same `size`.
