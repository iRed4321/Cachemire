    in property <color> tint: Theme.text-secondary;
    in property <length> size: 14px;
    width: size;
    height: size;

    Path {
        width: 100%;
        height: 100%;
        viewbox-y: 0.5;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M11 3 h9 a2 2 0 0 1 2 2 v9 a2 2 0 0 1 -2 2 h-9 a2 2 0 0 1 -2 -2 v-9 a2 2 0 0 1 2 -2 z M7 9 H4 a2 2 0 0 0 -2 2 v9 a2 2 0 0 0 2 2 h9 a2 2 0 0 0 2 -2 v-2";
        fill: transparent;
        stroke: tint;
        stroke-width: 1.5px;
        stroke-line-cap: round;
        stroke-line-join: round;
    }
}

