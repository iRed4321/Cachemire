// a cloud: outlined, or filled with its tint
export component IconCloud inherits Rectangle {
    in property <color> tint: Theme.text-secondary;
    in property <length> size: 14px;
    in property <bool> filled: false;
    width: size;
    height: size;

    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M18 10 h -1.26 A 8 8 0 1 0 9 20 h 9 a 5 5 0 0 0 0 -10 z";
        fill: root.filled ? tint : transparent;
        stroke: tint;
        stroke-width: 1.7px;
        stroke-line-cap: round;
        stroke-line-join: round;
    }
}

