import { Theme } from "theme.slint";

export component IconDot inherits Rectangle {
    in property <color> tint: Theme.text-secondary;
    in property <length> size: 8px;
    width: size;
    height: size;
    border-radius: size / 2;
    background: tint;
}

export component IconSearch inherits Rectangle {
    in property <color> tint: Theme.text-secondary;
    in property <length> size: 14px;
    width: size;
    height: size;

    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        // lens centered at (11,11) r=8, handle from the lens edge at 45° to
        // the corner, so the two visibly join instead of leaving a gap
        commands: "M11 3 a8 8 0 1 0 0 16 a8 8 0 1 0 0 -16 M16.65 16.65 L21 21";
        fill: transparent;
        stroke: tint;
        stroke-width: 1.7px;
        stroke-line-cap: round;
    }
}

// Every icon below is Rectangles or a Path, never a text glyph — a glyph
// like "▸" renders as a placeholder box without that font installed. Path
// data uses a 24x24 viewbox, stroke width in absolute px.

export component IconChevron inherits Rectangle {
    in property <color> tint: Theme.text-secondary;
    in property <length> size: 10px;
    in property <bool> down: false;
    in property <bool> up: false; // takes precedence over `down`
    width: size;
    height: size;

    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: up ? "M6 15 L12 9 L18 15" : (down ? "M6 9 L12 15 L18 9" : "M9 6 L15 12 L9 18");
        fill: transparent;
        stroke: tint;
        stroke-width: 1.8px;
        stroke-line-cap: round;
        stroke-line-join: round;
    }
}

// Three-quarter arc spinning forever. Instantiate only while loading (e.g.
// `if loading:`) so destroying it stops the animation. Moves the arc's
// endpoints, not a rotation — Slint's software renderer ignores `transform-rotation`.
export component IconSpinner inherits Rectangle {
    in property <color> tint: Theme.accent-blue;
    in property <length> size: 12px;
    width: size;
    height: size;

    property <angle> spin: 0deg;
    animate spin { duration: 700ms; iteration-count: -1; easing: linear; }
    init => { spin = 360deg; }

    // 270° clockwise arc of radius 9 around the 24x24 viewbox center,
    // starting at `spin`
    property <float> start-x: 12 + 9 * Math.cos(spin);
    property <float> start-y: 12 + 9 * Math.sin(spin);
    property <float> end-x: 12 + 9 * Math.cos(spin + 270deg);
    property <float> end-y: 12 + 9 * Math.sin(spin + 270deg);

    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        // Rounded to whole units: a `float` concatenated into a string uses
        // the locale's decimal separator (a comma in French), breaking SVG
        // syntax. `int` never does, and whole pixels are fine at this size.
        commands: "M " + start-x.round() + " " + start-y.round() + " A 9 9 0 1 1 " + end-x.round() + " " + end-y.round();
        fill: transparent;
        stroke: tint;
        stroke-width: 1.8px;
        stroke-line-cap: round;
    }
}

export component IconFolder inherits Rectangle {
    in property <color> tint: Theme.text-secondary;
    in property <length> size: 14px;
    width: size;
    height: size * 0.8;
    y: size * 0.1;

    Rectangle {
        x: 0;
        y: 0;
        width: parent.width * 0.45;
        height: parent.height * 0.28;
        border-top-left-radius: 1.5px;
        border-top-right-radius: 1.5px;
        background: tint;
    }
    Rectangle {
        x: 0;
        y: parent.height * 0.22;
        width: parent.width;
        height: parent.height * 0.78;
        border-radius: 1.5px;
        background: tint;
    }
}

