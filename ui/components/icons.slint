// Small filled triangle, pointing up or down: the sort direction of a column.
// Two paths rather than a rotation (the software renderer ignores `transform-rotation`).
export component IconSortTriangle inherits Rectangle {
    in property <color> tint: Theme.text-secondary;
    in property <length> size: 10px;
    in property <bool> up: true;
    width: size;
    height: size;

    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: up ? "M12 6 L21 18 L3 18 Z" : "M3 6 L21 6 L12 18 Z";
        fill: tint;
        stroke: tint;
        stroke-width: 1.5px;
        stroke-line-join: round;
    }
}
