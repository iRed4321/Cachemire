export component IconFilter inherits Rectangle {
    in property <color> tint: Theme.text-secondary;
    in property <length> size: 14px;
    width: size;
    height: size;
    VerticalLayout {
        alignment: center;
        spacing: 3px;
        padding-left: 1px;
        padding-right: 1px;
        Rectangle { height: 1.3px; width: parent.width; background: tint; }
        Rectangle { height: 1.3px; width: parent.width * 0.66; background: tint; }
        Rectangle { height: 1.3px; width: parent.width * 0.33; background: tint; }
    }
}

export component IconKey inherits Rectangle {
    in property <color> tint: Theme.text-secondary;
    in property <length> size: 14px;
    width: size;
    height: size * 0.6;
    y: size * 0.2;

    Rectangle {
        x: 0;
        y: (parent.height - self.height) / 2;
        width: parent.height * 0.85;
        height: parent.height * 0.85;
        border-radius: self.width / 2;
        border-width: 1.3px;
        border-color: tint;
        background: transparent;
    }
    Rectangle {
        x: parent.height * 0.75;
        y: (parent.height - 1.2px) / 2;
        width: parent.width - parent.height * 0.75;
        height: 1.2px;
        background: tint;
    }
    Rectangle {
        x: parent.width - parent.height * 0.22;
        y: parent.height * 0.5;
        width: 1.2px;
        height: parent.height * 0.4;
        background: tint;
    }
}

