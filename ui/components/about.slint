import { Theme } from "theme.slint";
import { ModalButton } from "widgets.slint";

// The "i" button's window: who made the app, which version this is and whether a newer one
// exists (all set by Rust).
export global About {
    in-out property <bool> open: false;
    in property <string> version: "";
    in property <string> status: "";
    in property <bool> busy: false;
    in property <bool> update-available: false;
    in property <string> download-label: "";
    callback open-repo();
    callback check();
    callback download();
}

export component AboutModal inherits Rectangle {
    background: #000000aa;

    TouchArea {
        clicked => { About.open = false; }
    }

    VerticalLayout {
        alignment: center;
        cross-axis-alignment: center;

        Rectangle {
            width: Theme.px(320px);
            background: Theme.bg-elevated;
            border-radius: Theme.radius-lg;
            border-width: 1px;
            border-color: Theme.border-soft;
            drop-shadow-color: Theme.shadow-color;
            drop-shadow-blur: Theme.shadow-blur;
            drop-shadow-offset-y: Theme.shadow-offset-y;

            // swallow clicks so they don't bubble to the backdrop's close
            TouchArea { }

            VerticalLayout {
                padding: Theme.px(24px);
                spacing: Theme.px(6px);

                Text {
                    text: "Cachemire by Léo Parent";
                    font-size: Theme.pt(14px);
                    font-weight: 700;
                    color: Theme.text-primary;
                    horizontal-alignment: center;
                }
                Text {
                    text: About.version;
                    font-size: Theme.pt(12.5px);
                    color: Theme.text-secondary;
                    horizontal-alignment: center;
                }
                repo := Text {
                    text: @tr("GitHub repository");
                    font-size: Theme.pt(12px);
                    color: Theme.accent-blue;
                    horizontal-alignment: center;

                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { About.open-repo(); }
                    }
                }
                Rectangle { height: Theme.px(8px); }
                // one button per row: the download button's label is long, and two in a row would
                // be wider than the card
                HorizontalLayout {
                    alignment: center;
                    ModalButton {
                        text: About.busy ? @tr("Checking...") : @tr("Check for updates");
                        clicked => { if (!About.busy) { About.check(); } }
                    }
                }
                if About.update-available: HorizontalLayout {
                    alignment: center;
                    ModalButton {
                        text: About.download-label;
                        primary: true;
                        clicked => { if (!About.busy) { About.download(); } }
                    }
                }
                if About.status != "": Text {
                    // a layout can't tell how far wrapped text grows: about 38 characters a line
                    height: Theme.pt(16px) * max(1, ceil(self.text.character-count / 38));
                    text: About.status;
                    font-size: Theme.pt(12px);
                    color: Theme.text-secondary;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }
        }
    }
}
